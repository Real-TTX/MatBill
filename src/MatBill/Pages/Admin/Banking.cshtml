@page
@model MatBill.Pages.Admin.BankingModel

<form class="mat-form" method="post" asp-page-handler="" novalidate>
    <mb-summary />
    @if (Model.TestResult is not null)
    {
        <div class="mat-alert mat-alert--@(Model.TestOk ? "success" : "danger")" role="status">@Ui.Icon(Model.TestOk ? "check-circle" : "alert")<div class="mat-alert__body">@Model.TestResult</div></div>
    }

    <mb-card title="@L["Admin.Banking.Matching"]" icon="check-square">
        <div class="mat-form__grid">
            <mb-switch for="Input.AutoMatch" label="@L["Admin.Banking.AutoMatch"]" full="true" />
            <p class="mat-hint mat-field--full">@L["Admin.Banking.AutoMatch.Hint"]</p>
        </div>
    </mb-card>

    <mb-card title="@L["Admin.Banking.Online"]" icon="link">
        <p class="mat-muted">@L["Admin.Banking.Online.Intro"]</p>
        <div class="mat-input-group">
            <input class="mat-input mat-mono" id="callback" value="@Model.CallbackUrl" readonly aria-label="@L["Admin.Banking.RedirectUrl"]" />
            <button type="button" class="mat-btn mat-btn--secondary" data-copy="#callback">@Ui.Icon("copy")<span>@L["Admin.Copy"]</span></button>
        </div>
        <div class="mat-form__grid">
            <mb-input for="Input.AppId" label="@L["Admin.Banking.AppId"]" autocomplete="off" full="true" />
            <mb-textarea for="Input.PrivateKey" label="@L["Admin.Banking.PrivateKey"]" rows="5" full="true" hint="@(Model.HasKey ? L["Admin.Banking.PrivateKey.Stored"] : L["Admin.Password.Encrypted"])" autocomplete="off" spellcheck="false" />
            <mb-input for="Input.Country" label="@L["Admin.Banking.Country"]" maxlength="2" />
            <mb-input for="Input.SyncHours" label="@L["Admin.Banking.SyncHours"]" type="number" min="1" max="48" step="1" hint="@L["Admin.Banking.SyncHours.Hint"]" />
        </div>
        <div class="mat-actions"><button type="submit" class="mat-btn mat-btn--secondary" asp-page-handler="Test">@Ui.Icon("refresh")<span>@L["Admin.Banking.Test"]</span></button></div>
        <p class="mat-hint">@L["Admin.Banking.Import.Hint"]</p>
    </mb-card>

    <mb-buttons back-href="/" />
</form>
