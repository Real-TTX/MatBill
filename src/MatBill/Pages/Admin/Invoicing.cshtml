@page
@using MatBill.Core.Billing
@model MatBill.Pages.Admin.InvoicingModel
@{
    var rates = InvoiceMath.CommonTaxRates.Select(r => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem($"{Amount.Quantity(r)} %", Amount.Quantity(r))).ToList();
}

<form class="mat-form" method="post" novalidate>
    <mb-summary />
    <mb-card title="@L["Admin.Invoicing.Ranges"]" icon="list" sub="@L["Admin.Invoicing.NextInvoice", Model.NextInvoice]">
        <p class="mat-muted">@L["Admin.Invoicing.Ranges.Hint"]</p>
        <div class="mat-form__grid">
            <mb-input for="Input.InvoiceNumberPattern" label="@L["Admin.Invoicing.InvoiceNumbers"]" required="true" autocomplete="off" />
            <mb-input for="Input.InvoiceNext" label="@L["Admin.Invoicing.Next"]" type="number" min="1" step="1" inputmode="numeric" hint="@L["Admin.Invoicing.Next.Hint", Model.NextNumbers["Input.InvoiceNext"]]" />
            <mb-input for="Input.CustomerNumberPattern" label="@L["Admin.Invoicing.CustomerNumbers"]" required="true" autocomplete="off" />
            <mb-input for="Input.CustomerNext" label="@L["Admin.Invoicing.Next"]" type="number" min="1" step="1" inputmode="numeric" hint="@L["Admin.Invoicing.Next.Hint", Model.NextNumbers["Input.CustomerNext"]]" />
            <mb-switch for="Input.CustomerNumberManual" label="@L["Admin.Invoicing.CustomerNumberManual"]" hint="@L["Admin.Invoicing.CustomerNumberManual.Hint"]" full="true" />
            <mb-input for="Input.QuoteNumberPattern" label="@L["Admin.Invoicing.QuoteNumbers"]" required="true" autocomplete="off" />
            <mb-input for="Input.QuoteNext" label="@L["Admin.Invoicing.Next"]" type="number" min="1" step="1" inputmode="numeric" hint="@L["Admin.Invoicing.Next.Hint", Model.NextNumbers["Input.QuoteNext"]]" />
            <mb-input for="Input.ExpenseNumberPattern" label="@L["Admin.Invoicing.ExpenseNumbers"]" required="true" autocomplete="off" />
            <mb-input for="Input.ExpenseNext" label="@L["Admin.Invoicing.Next"]" type="number" min="1" step="1" inputmode="numeric" hint="@L["Admin.Invoicing.Next.Hint", Model.NextNumbers["Input.ExpenseNext"]]" />
        </div>
        <p class="mat-hint">@L["Admin.Invoicing.Cancellation.Hint"]</p>
    </mb-card>

    <mb-card title="@L["Admin.Invoicing.EInvoice"]" icon="file-document">
        <div class="mat-form__grid">
            <mb-switch for="Input.ZugferdPdf" label="@L["Admin.Invoicing.Zugferd"]" full="true" />
        </div>
        <p class="mat-hint">@L["Admin.Invoicing.EInvoice.Hint"]</p>
    </mb-card>

    <mb-card title="@L["Admin.Invoicing.Quotes"]" icon="file-document">
        <div class="mat-form__grid">
            <mb-input for="Input.QuoteValidityDays" label="@L["Admin.Invoicing.QuoteValidityDays"]" type="number" min="1" max="365" step="1" />
            <mb-textarea for="Input.QuoteIntroText" label="@L["Admin.Invoicing.Intro"]" rows="3" full="true" />
            <mb-textarea for="Input.QuoteTerms" label="@L["Admin.Invoicing.QuoteTerms"]" rows="3" full="true" hint="@L["Admin.Invoicing.QuoteTerms.Hint"]" />
        </div>
    </mb-card>

    <mb-card title="@L["Admin.Invoicing.Expenses"]" icon="euro">
        <div class="mat-form__grid">
            <mb-textarea for="Input.Categories" label="@L["Admin.Invoicing.Categories"]" rows="8" full="true" hint="@L["Admin.Invoicing.Categories.Hint"]" />
        </div>
    </mb-card>

    <mb-card title="@L["Admin.Invoicing.NewInvoices"]" icon="file-text">
        <div class="mat-form__grid">
            <mb-input for="Input.PaymentTermDays" label="@L["Admin.Invoicing.PaymentTermDays"]" type="number" min="0" max="365" step="1" hint="@L["Admin.Invoicing.PaymentTermDays.Hint"]" />
            <mb-select for="Input.DefaultTaxRate" label="@L["Admin.Invoicing.DefaultTaxRate"]" items="rates" hint="@(Model.SmallBusiness ? L["Admin.Invoicing.DefaultTaxRate.Small"].Value : null)" />
            <mb-textarea for="Input.IntroText" label="@L["Admin.Invoicing.Intro"]" rows="3" full="true" />
            <mb-textarea for="Input.PaymentTerms" label="@L["Admin.Invoicing.PaymentTerms"]" rows="3" full="true" hint="@L["Admin.Invoicing.PaymentTerms.Hint"]" />
            <mb-textarea for="Input.ClosingText" label="@L["Admin.Invoicing.ClosingText"]" rows="2" full="true" />
            <mb-textarea for="Input.SmallBusinessNote" label="@L["Admin.Invoicing.SmallBusinessNote"]" rows="2" full="true" hint="@L["Admin.Invoicing.SmallBusinessNote.Hint"]" />
        </div>
    </mb-card>

    <mb-card title="@L["Admin.Invoicing.Recurring"]" icon="repeat">
        <div class="mat-form__grid">
            <mb-input for="Input.NoticeDays" label="@L["Admin.Invoicing.NoticeDays"]" type="number" min="0" max="30" step="1" hint="@L["Admin.Invoicing.NoticeDays.Hint"]" />
        </div>
    </mb-card>

    <mb-buttons back-href="/" />
</form>
