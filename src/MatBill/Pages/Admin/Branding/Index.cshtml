@page
@model MatBill.Pages.Admin.Branding.IndexModel
@{
    var layouts = MatBill.Configuration.DocumentLayouts.All.Select(l => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(L["Branding.Layout." + l].Value, l)).ToList();
}

<div class="mb-split">
    <form class="mat-form" method="post" enctype="multipart/form-data" novalidate>
        <mb-summary />
        <mb-card title="@L["Branding.Logo"]" icon="image">
            <div class="mb-logo-current">
                @if (Model.LogoUrl is not null)
                {
                    <img src="@Model.LogoUrl" alt="@L["Branding.Logo.Current"]" />
                    <button type="submit" class="mat-btn mat-btn--ghost mat-btn--sm" formnovalidate asp-page-handler="RemoveLogo" data-confirm="@L["Branding.Logo.Remove.Confirm"]" data-confirm-ok="@L["Branding.Logo.Remove"]">@Ui.Icon("trash")<span>@L["Branding.Logo.Remove"]</span></button>
                }
                else
                {
                    <p class="mat-muted">@L["Branding.Logo.None"]</p>
                }
            </div>
            <div class="mat-field">
                <label class="mat-label" for="Logo">@(Model.LogoUrl is null ? L["Branding.Logo.Upload"] : L["Branding.Logo.New"])</label>
                <div class="mat-upload" data-upload data-max-size="2MB" data-max-files="1"><input class="mat-upload__input" type="file" id="Logo" name="Logo" accept=".svg,.png,.jpg,.jpeg,image/svg+xml,image/png,image/jpeg" /></div>
                <span class="mat-hint">@L["Branding.Logo.Hint"]</span>
                <span class="mat-error" aria-live="polite">@ViewData.ModelState["Logo"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
            </div>
        </mb-card>

        <mb-card title="@L["Branding.Design"]" icon="palette">
            <div class="mat-form__grid">
                <mb-radios for="Input.Layout" label="@L["Branding.Layout"]" items="layouts" full="true" />
                <div class="mat-field">
                    <label class="mat-label" for="Input_AccentColor">@L["Branding.Accent"]</label>
                    <div class="mat-picker" data-picker="colour"><input class="mat-picker__input" id="Input_AccentColor" name="Input.AccentColor" value="@Model.Input.AccentColor" /></div>
                    <span class="mat-hint">@L["Branding.Accent.Hint"]</span>
                    <span class="mat-error" aria-live="polite">@ViewData.ModelState["Input.AccentColor"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                </div>
                <mb-input for="Input.Signature" label="@L["Branding.Signature"]" hint="@L["Branding.Signature.Hint"]" />
            </div>
        </mb-card>

        <mb-card title="@L["Branding.Footer"]" icon="file-text">
            <p class="mat-muted">@L["Branding.Footer.Text"]</p>
            <div class="mat-form__grid">
                <mb-textarea for="Input.Footer[0]" label="@L["Branding.Footer.Column", 1]" rows="6" placeholder="{Name}&#10;{NameLine2}&#10;{Street}&#10;{PostalCode} {City}&#10;{Manager}" data-footer-input />
                <mb-textarea for="Input.Footer[1]" label="@L["Branding.Footer.Column", 2]" rows="6" placeholder="Tel. {Phone}&#10;{Email}&#10;{Website}" data-footer-input />
                <mb-textarea for="Input.Footer[2]" label="@L["Branding.Footer.Column", 3]" rows="6" placeholder="{BankName}&#10;IBAN {Iban}&#10;BIC {Bic}&#10;{Bank2Name}&#10;IBAN {Bank2Iban}&#10;BIC {Bank2Bic}" data-footer-input />
                <mb-textarea for="Input.Footer[3]" label="@L["Branding.Footer.Column", 4]" rows="6" placeholder="Steuernummer {TaxNumber}&#10;USt-IdNr. {VatId}&#10;{Register}" data-footer-input />
            </div>
            <p class="mat-hint">@L["Branding.Footer.Placeholders"] <code>@string.Join(" ", DocumentFooter.Placeholders.Select(p => "{" + p.Name + "}"))</code></p>
        </mb-card>

        <mb-buttons back-href="/" />
    </form>

    <aside aria-label="@L["Branding.Preview"]">
        <div class="mat-card">
            <div class="mat-card__head">@Ui.Icon("eye")<h2 class="mat-card__title">@L["Branding.Preview"]</h2><span class="mat-card__sub">@L["Branding.Preview.Sub"]</span></div>
            <div class="mat-card__body">
                <div class="mb-brand-preview">
                    <a href="/Admin/Branding?handler=Preview&amp;v=@Model.PreviewVersion" data-preview-image data-preview-link title="@L["Branding.Preview.Open"]"><img src="/Admin/Branding?handler=Preview&amp;v=@Model.PreviewVersion" width="794" height="1123" alt="@L["Branding.Preview.Alt"]" data-preview-img /></a>
                </div>
                <p class="mat-hint"><a href="/Admin/Company">@L["Branding.ToCompany"]</a></p>
            </div>
        </div>
    </aside>
</div>
