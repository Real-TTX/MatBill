@page
@model MatBill.Pages.Admin.SecurityModel

<form class="mat-form" method="post" novalidate>
    <mb-summary />
    <mb-tabs id="security" label="@L["Admin.Security.Title"]">
        <mb-tab id="signin" title="@L["Admin.Security.SignIn"]" icon="shield">
            <mb-card>
                <div class="mat-form__grid">
                    <mb-input for="Input.SessionDays" label="@L["Admin.Security.SessionDays"]" type="number" min="1" max="365" hint="@L["Admin.Security.SessionDays.Hint"]" />
                    <mb-switch for="Input.RequireTotpForAdmins" label="@L["Admin.Security.RequireTotp"]" full="true" />
                </div>
            </mb-card>
        </mb-tab>

        <mb-tab id="links" title="@L["Admin.Security.Links"]" icon="link">
            <mb-card>
                <div class="mat-form__grid">
                    <mb-input for="Input.ShareLinkDays" label="@L["Admin.Security.ShareLinkDays"]" type="number" min="1" max="365" hint="@L["Admin.Security.ShareLinkDays.Hint"]" />
                </div>
            </mb-card>
        </mb-tab>

        <mb-tab id="address" title="@L["Admin.Security.Address"]" icon="globe">
            <mb-card>
                <div class="mat-form__grid">
                    <mb-input for="Input.PublicUrl" label="@L["Admin.Security.PublicUrl"]" type="url" full="true" hint="@(Model.UrlFromEnvironment ? L["Admin.Security.PublicUrl.Environment"] : L["Admin.Security.PublicUrl.Hint", Model.CurrentBase])" />
                    <mb-switch for="Input.ForceSecureCookie" label="@L["Admin.Security.ForceSecureCookie"]" full="true" />
                </div>
            </mb-card>
        </mb-tab>
    </mb-tabs>
    <mb-buttons back-href="/" />
</form>
