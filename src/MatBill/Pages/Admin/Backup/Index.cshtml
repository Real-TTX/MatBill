@page
@model MatBill.Pages.Admin.Backup.IndexModel
@{
    var scopes = Controls.Options.Of<BackupScope>(MatBill.Pages.Admin.Backup.Plans.IndexModel.Of);
    var scheduled = Model.Enabled && Model.Plans.Any(p => p.IsEnabled);
    var refresh = $"<a href=\"/Admin/Backup\">{System.Net.WebUtility.HtmlEncode(L["Backup.Running.Refresh"].Value)}</a>";
}

@if (Model.Running)
{
    <div class="mat-alert mat-alert--info" role="status">@Ui.Icon("refresh")<div class="mat-alert__body">@Html.Raw(L["Backup.Running", refresh].Value)</div></div>
}

@if (Model.TargetCount == 0 || Model.Plans.Count == 0)
{
    <div class="mat-alert mat-alert--warning">@Ui.Icon("alert")<div class="mat-alert__body">
        <strong>@L["Backup.Nothing"]</strong>
        @(Model.TargetCount == 0 ? L["Backup.Nothing.NoTarget"] : L["Backup.Nothing.NoPlan"])
    </div></div>
}
else if (!Model.Enabled)
{
    <div class="mat-alert mat-alert--warning">@Ui.Icon("alert")<div class="mat-alert__body"><strong>@L["Backup.Paused"]</strong> @L["Backup.Paused.Text"]</div></div>
}

<div class="mb-kpis">
    @Ui.Kpi(L["Backup.Kpi.Scheduled"], scheduled ? L["Backup.On"] : L["Backup.Off"], Ui.Plural(Model.Plans.Count(p => p.IsEnabled), L["Backup.Kpi.PlanActive"], L["Backup.Kpi.PlansActive"]), "archive", scheduled ? "ok" : "warn")
    @Ui.Kpi(L["Backup.Kpi.Last"], Model.LastRun is null ? L["Backup.Never"].Value : Fmt.Date(Model.LastRun.StartDate), Model.LastRun is null ? null : Model.LastRun.Status == BackupRunStatus.Success ? L["Backup.Succeeded"].Value : L["Backup.Failed"].Value, "clock", Model.LastRun?.Status == BackupRunStatus.Failed ? "error" : "busy", bad: Model.LastRun?.Status == BackupRunStatus.Failed)
    @Ui.Kpi(L["Backup.Kpi.Next"], Model.Enabled && Model.NextRun is not null ? Fmt.Date(Model.NextRun) : "–", Model.Enabled && Model.NextRun is not null ? Fmt.Moment(Model.NextRun) : null, "calendar", "info")
</div>

<mb-card title="@L["Backup.Recent"]" icon="shield">
    <partial name="_Table" model="Model.Runs" />
    <partial name="_Pager" model="Model.Pager" />
</mb-card>

<div class="mat-actions">
    <a class="mat-btn mat-btn--primary" href="/Admin/Backup/Plans">@Ui.Icon("calendar")<span>@L["Backup.Plans"]</span></a>
    <a class="mat-btn mat-btn--secondary" href="/Admin/Backup/Targets">@Ui.Icon("hard-drive")<span>@L["Backup.Targets"]</span></a>
    <a class="mat-btn mat-btn--secondary" href="/Admin/Backup/Restore">@Ui.Icon("upload")<span>@L["Backup.Restore"]</span></a>
    <form method="post"><button type="submit" asp-page-handler="Toggle" class="mat-btn mat-btn--ghost">@Ui.Icon(Model.Enabled ? "pause" : "play")<span>@(Model.Enabled ? L["Backup.Pause"] : L["Backup.Resume"])</span></button></form>
</div>

<mb-card title="@L["Backup.Download.Card"]" icon="download">
    <form class="mat-form" method="post" asp-page-handler="Download">
        <p class="mat-muted">@L["Backup.Download.Text"]</p>
        <div class="mat-form__grid">
            <div class="mat-field"><label class="mat-label" for="scope">@L["Backup.Scope"]</label><select class="mat-select" id="scope" name="scope">@foreach (var s in scopes) { <option value="@s.Value">@s.Text</option> }</select></div>
            <div class="mat-field"><label class="mat-label" for="passphrase">@L["Backup.Download.Passphrase"]</label><input class="mat-input" id="passphrase" name="passphrase" type="password" autocomplete="new-password" /><span class="mat-error" aria-live="polite"></span></div>
        </div>
        <div class="mat-btn-row mat-btn-row--plain"><button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("download")<span>@L["Backup.Download.Submit"]</span></button></div>
    </form>
</mb-card>
