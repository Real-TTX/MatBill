@page
@model MatBill.Pages.Admin.Backup.Restore.IndexModel
@{
    var createTarget = $"<a href=\"/Admin/Backup/Targets/Edit\">{System.Net.WebUtility.HtmlEncode(L["Backup.Restore.NoTarget.Link"].Value)}</a>";
}

<div class="mat-alert mat-alert--warning">@Ui.Icon("alert")<div class="mat-alert__body">
    <strong>@L["Backup.Restore.Warning"]</strong> @L["Backup.Restore.Warning.Text"]
</div></div>

<mb-card title="@L["Backup.Restore.FromTarget"]" icon="hard-drive">
    @if (Model.Targets.Count == 0)
    {
        <p class="mat-muted">@Html.Raw(L["Backup.Restore.NoTarget", createTarget].Value)</p>
    }
    else
    {
        <form class="mat-form mb-diff__bar" method="get">
            <div class="mat-field"><label class="mat-label" for="targetId">@L["Backup.Target"]</label><select class="mat-select" id="targetId" name="targetId">@foreach (var t in Model.Targets) { <option value="@t.Value" selected="@t.Selected">@t.Text</option> }</select></div>
            <button type="submit" class="mat-btn mat-btn--secondary">@Ui.Icon("list")<span>@L["Backup.Restore.Show"]</span></button>
        </form>

        @if (Model.ListError is not null)
        {
            <div class="mat-alert mat-alert--danger">@Ui.Icon("alert")<div class="mat-alert__body">@Model.ListError</div></div>
        }
        else if (Model.TargetId is not null)
        {
            @if (Model.Files.Count == 0)
            {
                <p class="mat-muted">@L["Backup.Restore.NoBackups"]</p>
            }
            else
            {
                <form method="post" asp-page-handler="Fetch" class="mat-form">
                    <input type="hidden" name="targetId" value="@Model.TargetId" />
                    <div class="mat-table-wrap">
                        <table class="mat-table" id="restore-files">
                            <caption class="mat-sr-only">@L["Backup.Restore.AtTarget"]</caption>
                            <thead><tr><th scope="col">@L["Backup.Restore.Col.Backup"]</th><th scope="col" class="mat-hide-sm">@L["Backup.Restore.Col.From"]</th><th scope="col" class="mat-num mat-hide-sm">@L["Backup.Size"]</th><th scope="col" class="mat-col-actions"><span class="mat-sr-only">@L["Backup.Actions"]</span></th></tr></thead>
                            <tbody>
                                @foreach (var f in Model.Files)
                                {
                                    <tr>
                                        <td data-label="@L["Backup.Restore.Col.Backup"]"><span class="mat-mono">@f.Name</span>@(MatBill.Services.Backup.BackupNames.IsEncrypted(f.Name) ? " 🔒" : "")</td>
                                        <td data-label="@L["Backup.Restore.Col.From"]" class="mat-hide-sm">@Fmt.Moment(f.CreatedUtc)</td>
                                        <td data-label="@L["Backup.Size"]" class="mat-num mat-hide-sm">@Fmt.FileSize(f.Size)</td>
                                        <td class="mat-col-actions"><button type="submit" name="name" value="@f.Name" class="mat-btn mat-btn--secondary mat-btn--sm">@Ui.Icon("upload")<span>@L["Backup.Restore.Select"]</span></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mat-field"><label class="mat-label" for="fetch-pass">@L["Backup.Restore.Passphrase"]</label><input class="mat-input" id="fetch-pass" name="passphrase" type="password" autocomplete="off" /><span class="mat-error" aria-live="polite"></span></div>
                </form>
            }
        }
    }
</mb-card>

<mb-card title="@L["Backup.Restore.FromFile"]" icon="upload">
    <form class="mat-form" method="post" asp-page-handler="Upload" enctype="multipart/form-data">
        <div class="mat-form__grid">
            <div class="mat-field"><label class="mat-label" for="file">@L["Backup.Restore.File"]</label><input class="mat-input" type="file" id="file" name="file" accept=".mbbackup,.enc,.zip" required data-msg-required="@L["Backup.Restore.File.Required"]" /><span class="mat-error" aria-live="polite"></span></div>
            <div class="mat-field"><label class="mat-label" for="upload-pass">@L["Backup.Restore.Passphrase"]</label><input class="mat-input" id="upload-pass" name="passphrase" type="password" autocomplete="off" /><span class="mat-error" aria-live="polite"></span></div>
        </div>
        <div class="mat-btn-row mat-btn-row--plain"><button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("upload")<span>@L["Backup.Restore.CheckFile"]</span></button></div>
    </form>
</mb-card>

@if (Model.SafetyCopies.Count > 0)
{
    <mb-card title="@L["Backup.Restore.SafetyCopies"]" icon="shield">
        <p class="mat-muted">@L["Backup.Restore.SafetyCopies.Text"]</p>
        <form method="post" asp-page-handler="Safety">
            <ul class="mb-comments">
                @foreach (var f in Model.SafetyCopies.OrderByDescending(f => f.CreatedUtc))
                {
                    <li class="mb-comment"><div class="mb-comment__head"><span>@Fmt.Moment(f.CreatedUtc) · @Fmt.FileSize(f.Size)</span><button type="submit" name="name" value="@f.Name" class="mat-btn mat-btn--secondary mat-btn--sm">@Ui.Icon("upload")<span>@L["Backup.Restore.Select"]</span></button></div></li>
                }
            </ul>
        </form>
    </mb-card>
}
