@page
@model MatBill.Pages.Admin.Backup.Restore.ConfirmModel

@if (Model.Result is { } result)
{
    var tables = Ui.Plural(result.Tables, L["Backup.Table"], L["Backup.Tables"]);
    var rows = Fmt.Integer(result.Rows);
    <div class="mat-alert mat-alert--success" role="status">@Ui.Icon("check-circle")<div class="mat-alert__body">
        <strong>@L["Backup.Restore.Done"]</strong> @(result.Files > 0 ? L["Backup.Restore.Done.TextFiles", tables, rows, Ui.Plural(result.Files, L["Backup.File"], L["Backup.Files"])] : L["Backup.Restore.Done.Text", tables, rows])
    </div></div>
    @if (result.SafetyCopy is not null)
    {
        <p class="mat-muted">@L["Backup.Restore.SafetyCopy"] <span class="mat-mono">@System.IO.Path.GetFileName(result.SafetyCopy)</span></p>
    }
    @foreach (var note in result.Notes)
    {
        <div class="mat-alert mat-alert--warning">@Ui.Icon("alert")<div class="mat-alert__body">@note</div></div>
    }
    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Account/Login">@Ui.Icon("login")<span>@L["Backup.Restore.SignInAgain"]</span></a>
        <a class="mat-btn mat-btn--secondary" href="/Admin/Backup">@Ui.Icon("back")<span>@L["Backup.ToOverview"]</span></a>
    </div>
}
else if (Model.Manifest is { } m)
{
    <form class="mat-form" method="post" novalidate>
        <input type="hidden" name="file" value="@Model.Staged" />
        <mb-summary />
        <mb-card title="@L["Backup.Restore.ThisBackup"]" icon="shield">
            <dl class="mat-kv">
                <dt>@L["Backup.Restore.Created"]</dt><dd>@Fmt.Moment(m.CreatedUtc)</dd>
                <dt>@L["Backup.Restore.Version"]</dt><dd>@m.App</dd>
                <dt>@L["Backup.Scope"]</dt><dd>@MatBill.Pages.Admin.Backup.Plans.IndexModel.Of(m.Scope)</dd>
                <dt>@L["Backup.Restore.Database"]</dt><dd>@(L["Backup.Restore.TablesRows", Ui.Plural(m.Tables.Count, L["Backup.Table"], L["Backup.Tables"]), Fmt.Integer(m.Tables.Sum(t => t.Rows))])</dd>
                <dt>@L["Backup.Restore.FilesLabel"]</dt><dd>@(m.Files.Count > 0 ? Ui.Plural(m.Files.Count, L["Backup.File"], L["Backup.Files"]) : L["Backup.Restore.NoFiles"].Value)@(m.Problems.Count > 0 ? " " + L["Backup.Restore.Missing", m.Problems.Count].Value : "")</dd>
                <dt>@L["Backup.Restore.SettingsLabel"]</dt><dd>@(m.HasSettings ? L["Backup.Restore.Included"] : L["Backup.Restore.NotIncluded"])</dd>
            </dl>
        </mb-card>

        <mb-card title="@L["Backup.Restore.What"]" icon="upload">
            <div class="mat-form__grid">
                <div class="mat-field mat-field--full"><span class="mat-hint">@L["Backup.Restore.DatabaseAlways"]</span></div>
                @if (m.Files.Count > 0)
                {
                    <mb-switch for="Input.Files" label="@L["Backup.Restore.FilesSwitch"]" full="true" />
                }
                @if (m.HasSettings)
                {
                    <mb-switch for="Input.Settings" label="@L["Backup.Restore.SettingsSwitch"]" full="true" />
                }
            </div>
        </mb-card>

        <mb-card title="@L["Backup.Restore.Confirm"]" icon="alert">
            <p>@L["Backup.Restore.Confirm.Text"]</p>
            <div class="mat-form__grid">
                <mb-input for="Input.Confirmation" label="@(L["Backup.Restore.Type", MatBill.Pages.Admin.Backup.Restore.ConfirmModel.Phrase])" full="true" autocomplete="off" required="true" />
            </div>
        </mb-card>

        <div class="mat-btn-row">
            <button type="submit" class="mat-btn mat-btn--danger" data-confirm="@L["Backup.Restore.Confirm.Dialog"]" data-confirm-ok="@L["Backup.Restore"]">@Ui.Icon("upload")<span>@L["Backup.Restore"]</span></button>
            <button type="submit" formnovalidate asp-page-handler="Cancel" class="mat-btn mat-btn--secondary">@Ui.Icon("back")<span>@L["Common.Cancel"]</span></button>
        </div>
    </form>
}
