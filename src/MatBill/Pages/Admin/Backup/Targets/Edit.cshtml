@page
@model MatBill.Pages.Admin.Backup.Targets.EditModel
@{
    var kinds = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L["Backup.Target.Kind.Smb"], nameof(BackupTargetKind.Smb)),
        new(L["Backup.Target.Kind.Local"], nameof(BackupTargetKind.Local)),
    };
}

<form class="mat-form" method="post" asp-page-handler="" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <mb-summary />
    @if (Model.Test is not null)
    {
        <div class="mat-alert mat-alert--@(Model.TestOk ? "success" : "danger")" role="status">@Ui.Icon(Model.TestOk ? "check-circle" : "alert")<div class="mat-alert__body">@Model.Test</div></div>
    }

    <mb-card title="@L["Backup.Target"]" icon="hard-drive">
        <div class="mat-form__grid">
            <mb-input for="Input.Name" label="@L["Common.Name"]" required="true" hint="@L["Backup.Target.Name.Hint"]" />
            <mb-select for="Input.Kind" label="@L["Backup.Target.Kind"]" items="kinds" />
            <mb-input for="Input.Host" label="@L["Backup.Target.Host"]" hint="@L["Backup.Target.Host.Hint"]" show-if="Input.Kind" show-value="Smb" />
            <mb-input for="Input.Share" label="@L["Backup.Target.Share"]" hint="@L["Backup.Target.Share.Hint"]" show-if="Input.Kind" show-value="Smb" />
            <mb-input for="Input.Path" label="@L["Backup.Target.Folder"]" full="true" hint="@L["Backup.Target.Path.Hint"]" />
            <mb-input for="Input.Domain" label="@L["Backup.Target.Domain"]" autocomplete="off" show-if="Input.Kind" show-value="Smb" />
            <mb-input for="Input.UserName" label="@L["Backup.Target.User"]" autocomplete="off" show-if="Input.Kind" show-value="Smb" />
            <mb-input for="Input.Password" label="@L["Backup.Password"]" type="password" autocomplete="new-password" show-if="Input.Kind" show-value="Smb" hint="@(Model.HasPassword ? L["Backup.KeepPassword"] : L["Backup.Target.Password.Hint"])" />
        </div>
    </mb-card>

    @if (Model.Target is not null)
    {
        <mb-buttons back-href="/Admin/Backup/Targets" delete-url="@Url.Page("/Admin/Backup/Targets/Edit", "Delete", new { id = Model.Id })" delete-confirm="@L["Backup.Target.Delete.Confirm"]">
            <button type="submit" formnovalidate asp-page-handler="Test" class="mat-btn mat-btn--secondary">@Ui.Icon("activity")<span>@L["Backup.Target.Test"]</span></button>
        </mb-buttons>
    }
    else
    {
        <mb-buttons back-href="/Admin/Backup/Targets">
            <button type="submit" formnovalidate asp-page-handler="Test" class="mat-btn mat-btn--secondary">@Ui.Icon("activity")<span>@L["Backup.Target.Test"]</span></button>
        </mb-buttons>
    }
</form>
