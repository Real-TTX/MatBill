@page
@model MatBill.Pages.Admin.Backup.Plans.IndexModel

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    <partial name="_Table" model="Model.Table" />
    <partial name="_Pager" model="Model.Pager" />
    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Admin/Backup/Plans/Edit">@Ui.Icon("plus")<span>@L["Backup.Plans.New"]</span></a>
        <a class="mat-btn mat-btn--secondary" href="/Admin/Backup">@Ui.Icon("back")<span>@L["Backup.ToOverview"]</span></a>
    </div>
</div>
