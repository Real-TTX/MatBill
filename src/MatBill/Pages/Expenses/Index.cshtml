@page
@model MatBill.Pages.Expenses.IndexModel

<div class="mb-stats">
    @Ui.Kpi(L["Expenses.Kpi.Year", DateTime.Today.Year], Fmt.Money(Model.YearNet), L[Model.SmallBusiness ? "Expenses.Kpi.Year.Note.Small" : "Expenses.Kpi.Year.Note"], "euro", href: $"/Expenses?year={DateTime.Today.Year}")
    @if (!Model.SmallBusiness)
    {
        @Ui.Kpi(L["Expenses.Kpi.InputTax", DateTime.Today.Year], Fmt.Money(Model.YearTax), L["Expenses.Kpi.InputTax.Note"], "file-text")
    }
    @Ui.Kpi(L["Expenses.Kpi.Open"], Fmt.Money(Model.OpenSum), L["Expenses.Kpi.Open.Note"], "clock", href: "/Expenses?status=open")
    @Ui.Kpi(L["Expenses.Kpi.Review"], Model.ToReview.ToString(), Model.ToReview == 0 ? L["Expenses.Kpi.Review.None"] : L["Expenses.Kpi.Review.Note"], "alert", href: "/Expenses?status=review", bad: Model.ToReview > 0)
</div>

<form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="mb-dropform" data-upload-form>
    <div class="mat-upload mb-drop" data-upload data-max-size="20MB" data-max-files="50" data-paste>
        <input class="mat-upload__input" type="file" id="Files" name="Files" multiple accept=".pdf,.png,.jpg,.jpeg,.heic,.webp,.xml" aria-label="@L["Expenses.Upload.Label"]" data-upload-autosubmit />
    </div>
    <p class="mat-hint">@L["Expenses.Upload.Hint"]</p>
    <noscript><button type="submit" class="mat-btn mat-btn--secondary">@Ui.Icon("upload")<span>@L["Common.Upload"]</span></button></noscript>
</form>

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    <partial name="_Table" model="Model.Table" />
    <partial name="_Pager" model="Model.Pager" />
    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Expenses/Edit">@Ui.Icon("plus")<span>@L["Expenses.New"]</span></a>
        <a class="mat-btn mat-btn--secondary" href="/Export">@Ui.Icon("download")<span>@L["Expenses.ToExport"]</span></a>
    </div>
</div>
