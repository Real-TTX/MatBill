@page
@model MatBill.Pages.Recurring.IndexModel

<div class="mb-stats">
    @Ui.Kpi("Aktive Serien", Model.Active.ToString(), Model.Problems > 0 ? Ui.CountNoun(Model.Problems, "Serien") + " mit Fehler" : "alle ohne Fehler", "repeat", href: Model.Problems > 0 ? "/Recurring?status=fehler" : "/Recurring?status=aktiv", bad: Model.Problems > 0)
    @Ui.Kpi("Nächste Rechnung", Model.Next is null ? "–" : Fmt.Date(Model.Next), Model.Next is null ? "keine geplant" : Fmt.Due(Model.Next, Model.Today), "calendar")
    @Ui.Kpi("Pro Monat", Fmt.Money(Model.MonthlyVolume), "brutto, im Durchschnitt", "euro")
</div>

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    <partial name="_Table" model="Model.Table" />
    <partial name="_Pager" model="Model.Pager" />
    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Recurring/Edit">@Ui.Icon("plus")<span>Neue Serie</span></a>
    </div>
</div>
