@page
@model MatBill.Pages.Account.TwoFactorModel
@{
    Layout = "_Bare";
    ViewData["Languages"] = true;
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>@L["Account.TwoFactor.Title"]</h1>
        <p class="mat-muted">@L["Account.TwoFactor.Intro"]</p>
    </div>

    <form class="mat-form" method="post" novalidate>
        <mb-summary title="@L["Account.TwoFactor.Failed"]" />
        <mb-input for="Code" label="@L["Account.TwoFactor.Code"]" type="text" inputmode="numeric" autocomplete="one-time-code" autofocus hint="@L["Account.TwoFactor.Code.Hint"]" />
        <div class="mat-btn-row mat-btn-row--plain">
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("shield")<span>@L["Account.TwoFactor.Confirm"]</span></button>
        </div>
    </form>
    <p class="mb-auth__alt"><a href="/Account/Login">@L["Common.Cancel"]</a></p>
</div>
