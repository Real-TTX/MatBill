@page
@model MatBill.Pages.Customers.EditModel
@{
    var kinds = Controls.Options.Of<CustomerKind>(Labels.Of);
}

@if (Model.Customer is not null)
{
    <div class="mb-stats">
        @Ui.Kpi(L["Customers.Kpi.Open"], Fmt.Money(Model.OpenSum), L["Customers.Kpi.Open.Note"], "clock", href: $"/Invoices?customer={Model.Customer.Id}&status=open")
        @Ui.Kpi(L["Customers.Kpi.Revenue", Model.Today.Year], Fmt.Money(Model.YearSum), L["Customers.Kpi.Revenue.Note"], "euro", href: $"/Invoices?customer={Model.Customer.Id}&year={Model.Today.Year}")
        @Ui.Kpi(L["Customers.Kpi.Series"], Model.Series.Count(s => s.Status == RecurringStatus.Active).ToString(), L["Customers.Kpi.Series.Note"], "repeat", href: $"/Recurring?customer={Model.Customer.Id}")
    </div>
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <mb-summary />
    <mb-card title="@L["Customers.Card.Customer"]" icon="building">
        <div class="mat-form__grid">
            <mb-radios for="Input.Kind" label="@L["Customers.Kind"]" items="kinds" />
            <mb-input for="Input.Name" label="@(Model.Input.Kind == CustomerKind.Person ? L["Customers.Name.Person"] : L["Customers.Name.Company"])" required="true" autocomplete="off" />
            <mb-input for="Input.ContactName" label="@L["Customers.Contact"]" show-if="Input.Kind" show-value="Company" hint="@L["Customers.Contact.Hint"]" />
            <mb-input for="Input.Email" label="@L["Customers.Email"]" type="email" inputmode="email" autocomplete="off" />
            <mb-input for="Input.Phone" label="@L["Common.Phone"]" type="tel" autocomplete="off" />
        </div>
    </mb-card>
    <mb-card title="@L["Customers.Card.Address"]" icon="home">
        <div class="mat-form__grid">
            <mb-input for="Input.Street" label="@L["Customers.Street"]" full="true" autocomplete="off" />
            <mb-input for="Input.PostalCode" label="@L["Customers.PostalCode"]" inputmode="numeric" autocomplete="off" />
            <mb-input for="Input.City" label="@L["Customers.City"]" autocomplete="off" />
            <mb-input for="Input.Country" label="@L["Customers.Country"]" autocomplete="off" />
        </div>
    </mb-card>
    <mb-card title="@L["Customers.Card.Invoices"]" icon="file-text">
        <div class="mat-form__grid">
            <mb-input for="Input.PaymentTermDays" label="@L["Customers.PaymentTerm"]" type="number" min="0" max="365" step="1" hint="@L["Customers.PaymentTerm.Hint"]" />
            <mb-input for="Input.VatId" label="@L["Customers.VatId"]" hint="@L["Customers.VatId.Hint"]" autocomplete="off" />
            <mb-input for="Input.BuyerReference" label="@L["Customers.BuyerReference"]" hint="@L["Customers.BuyerReference.Hint"]" autocomplete="off" />
            <mb-textarea for="Input.Note" label="@L["Customers.Note"]" rows="3" full="true" />
        </div>
    </mb-card>

    @if (Model.Customer is null)
    {
        <mb-buttons back-href="/Customers" />
    }
    else
    {
        <mb-buttons back-href="/Customers" delete-url="@Url.Page("/Customers/Edit", "Delete", new { id = Model.Id })" delete-confirm="@L["Customers.Delete.Confirm"]">
            <a class="mat-btn mat-btn--secondary" href="/Invoices/Edit?customer=@Model.Customer.Id">@Ui.Icon("file-plus")<span>@L["Customers.NewInvoice"]</span></a>
        </mb-buttons>
    }
</form>

@if (Model.Customer is not null)
{
    <section class="mat-card" aria-labelledby="customer-invoices">
        <div class="mat-card__head">@Ui.Icon("file-text")<h2 class="mat-card__title" id="customer-invoices">@L["Customers.Card.Invoices"]</h2></div>
        <div class="mat-card__body">
            @if (Model.Invoices.Count == 0)
            {
                <p class="mat-muted">@L["Customers.Invoices.None"] <a href="/Invoices/Edit?customer=@Model.Customer.Id">@L["Customers.Invoices.WriteOne"]</a></p>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <caption class="mat-sr-only">@L["Customers.Invoices.Caption"]</caption>
                        <thead><tr><th scope="col">@L["Customers.Column.Number"]</th><th scope="col">@L["Common.Date"]</th><th scope="col" class="mat-num">@L["Common.Amount"]</th><th scope="col">@L["Common.Status"]</th></tr></thead>
                        <tbody>
                            @foreach (var i in Model.Invoices)
                            {
                                <tr>
                                    <td data-label="@L["Customers.Column.Number"]"><a href="/Invoices/Edit?id=@i.Id">@(i.Number ?? L["Customers.Invoices.Draft"])</a></td>
                                    <td data-label="@L["Common.Date"]">@Fmt.Date(i.InvoiceDate)</td>
                                    <td data-label="@L["Common.Amount"]" class="mat-num">@Ui.Money(i.GrossTotal)</td>
                                    <td data-label="@L["Common.Status"]">@Labels.Pill(i, Model.Today)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="mat-hint"><a href="/Invoices?customer=@Model.Customer.Id">@L["Customers.Invoices.All"]</a></p>
            }
        </div>
    </section>
}
