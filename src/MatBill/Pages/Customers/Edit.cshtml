@page
@model MatBill.Pages.Customers.EditModel
@{
    var kinds = Controls.Options.Of<CustomerKind>(Labels.Of);
}

@if (Model.Customer is not null)
{
    <div class="mb-stats">
        @Ui.Kpi("Offen", Fmt.Money(Model.OpenSum), "noch nicht bezahlt", "clock", href: $"/Invoices?kunde={Model.Customer.Id}&status=offen")
        @Ui.Kpi($"Umsatz {Model.Today.Year}", Fmt.Money(Model.YearSum), "brutto, ausgestellt", "euro", href: $"/Invoices?kunde={Model.Customer.Id}&jahr={Model.Today.Year}")
        @Ui.Kpi("Serien", Model.Series.Count(s => s.Status == RecurringStatus.Active).ToString(), "aktiv", "repeat", href: $"/Recurring?kunde={Model.Customer.Id}")
    </div>
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <mb-summary />
    <mb-card title="Kunde" icon="building">
        <div class="mat-form__grid">
            <mb-radios for="Input.Kind" label="Art" items="kinds" />
            <mb-input for="Input.Name" label="@(Model.Input.Kind == CustomerKind.Person ? "Name" : "Firma oder Name")" required="true" autocomplete="off" />
            <mb-input for="Input.ContactName" label="Ansprechpartner" show-if="Input.Kind" show-value="Company" hint="Steht unter dem Namen in der Anschrift." />
            <mb-input for="Input.Email" label="E-Mail für Rechnungen" type="email" inputmode="email" autocomplete="off" />
            <mb-input for="Input.Phone" label="Telefon" type="tel" autocomplete="off" />
        </div>
    </mb-card>
    <mb-card title="Anschrift" icon="home">
        <div class="mat-form__grid">
            <mb-input for="Input.Street" label="Straße und Hausnummer" full="true" autocomplete="off" />
            <mb-input for="Input.PostalCode" label="PLZ" inputmode="numeric" autocomplete="off" />
            <mb-input for="Input.City" label="Ort" autocomplete="off" />
            <mb-input for="Input.Country" label="Land" autocomplete="off" />
        </div>
    </mb-card>
    <mb-card title="Rechnungen" icon="file-text">
        <div class="mat-form__grid">
            <mb-input for="Input.PaymentTermDays" label="Eigenes Zahlungsziel (Tage)" type="number" min="0" max="365" step="1" hint="Leer: das Zahlungsziel aus den Einstellungen." />
            <mb-input for="Input.VatId" label="USt-IdNr. des Kunden" hint="Nötig für Rechnungen an Firmen im EU-Ausland." autocomplete="off" />
            <mb-textarea for="Input.Note" label="Notiz (intern)" rows="3" full="true" />
        </div>
    </mb-card>

    @if (Model.Customer is null)
    {
        <mb-buttons back-href="/Customers" />
    }
    else
    {
        <mb-buttons back-href="/Customers" delete-url="@Url.Page("/Customers/Edit", "Delete", new { id = Model.Id })" delete-confirm="Diesen Kunden löschen? Seine Rechnungen bleiben erhalten.">
            <a class="mat-btn mat-btn--secondary" href="/Invoices/Edit?customer=@Model.Customer.Id">@Ui.Icon("file-plus")<span>Neue Rechnung</span></a>
        </mb-buttons>
    }
</form>

@if (Model.Customer is not null)
{
    <section class="mat-card" aria-labelledby="customer-invoices">
        <div class="mat-card__head">@Ui.Icon("file-text")<h2 class="mat-card__title" id="customer-invoices">Rechnungen</h2></div>
        <div class="mat-card__body">
            @if (Model.Invoices.Count == 0)
            {
                <p class="mat-muted">Noch keine Rechnung. <a href="/Invoices/Edit?customer=@Model.Customer.Id">Jetzt eine schreiben</a></p>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <caption class="mat-sr-only">Rechnungen des Kunden</caption>
                        <thead><tr><th scope="col">Nummer</th><th scope="col">Datum</th><th scope="col" class="mat-num">Betrag</th><th scope="col">Status</th></tr></thead>
                        <tbody>
                            @foreach (var i in Model.Invoices)
                            {
                                <tr>
                                    <td data-label="Nummer"><a href="/Invoices/Edit?id=@i.Id">@(i.Number ?? "Entwurf")</a></td>
                                    <td data-label="Datum">@Fmt.Date(i.InvoiceDate)</td>
                                    <td data-label="Betrag" class="mat-num">@Ui.Money(i.GrossTotal)</td>
                                    <td data-label="Status">@Labels.Pill(i, Model.Today)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="mat-hint"><a href="/Invoices?kunde=@Model.Customer.Id">Alle Rechnungen dieses Kunden</a></p>
            }
        </div>
    </section>
}
