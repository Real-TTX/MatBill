@page
@model MatBill.Pages.Banking.Accounts.EditModel

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <mb-summary />
    <mb-card title="@L["Banking.Account"]" icon="credit-card">
        <div class="mat-form__grid">
            <mb-input for="Input.Name" label="@L["Common.Name"]" required="true" hint="@L["Banking.AccountEdit.Name.Hint"]" autocomplete="off" />
            <mb-input for="Input.BankName" label="@L["Banking.AccountEdit.Bank"]" autocomplete="off" />
            <mb-input for="Input.Iban" label="IBAN" autocomplete="off" hint="@L["Banking.AccountEdit.Iban.Hint"]" />
            <mb-input for="Input.Bic" label="BIC" autocomplete="off" />
            <mb-switch for="Input.IsActive" label="@L["Banking.AccountEdit.Active"]" full="true" />
        </div>
    </mb-card>

    @if (Model.Account is null)
    {
        <mb-buttons back-href="/Banking" />
    }
    else
    {
        <mb-buttons back-href="/Banking" delete-url="@Url.Page("/Banking/Accounts/Edit", "Delete", new { id = Model.Id })" delete-confirm="@L["Banking.AccountEdit.DeleteConfirm"]">
            <a class="mat-btn mat-btn--secondary" href="/Banking/Import?account=@Model.Id">@Ui.Icon("upload")<span>@L["Banking.Import"]</span></a>
        </mb-buttons>
    }
</form>

@if (Model.Account is { } a)
{
    <mb-card title="@L["Banking.AccountEdit.Fetch"]" icon="refresh" sub="@L["Banking.AccountEdit.TransactionCount", Model.Transactions]">
        <dl class="mat-kv">
            <dt>@L["Banking.AccountEdit.Kind"]</dt><dd>@(a.Provider == BankProvider.EnableBanking ? L["Banking.AccountEdit.Kind.Online", a.BankConnection?.BankName ?? ""] : L["Banking.AccountEdit.Kind.Files"])</dd>
            @if (a.BankConnection is { } c)
            {
                <dt>@L["Banking.AccountEdit.Access"]</dt><dd>@(c.Status == BankConnectionStatus.Active ? L["Banking.AccountEdit.Access.ValidUntil", Fmt.Date(c.ValidUntil)] : L["Banking.AccountEdit.Access.Expired"])</dd>
            }
            <dt>@L["Banking.AccountEdit.Balance"]</dt><dd>@(a.Balance is null ? "–" : L["Banking.AccountEdit.Balance.On", Fmt.Money(a.Balance.Value), Fmt.Date(a.BalanceDate)])</dd>
            <dt>@L["Banking.AccountEdit.LastFetched"]</dt><dd>@(a.LastSyncDate is null ? "–" : Fmt.Moment(a.LastSyncDate))</dd>
        </dl>
        @if (a.Provider == BankProvider.EnableBanking && a.BankConnection?.Status != BankConnectionStatus.Active)
        {
            <a class="mat-btn mat-btn--secondary" href="/Banking/Connect">@Ui.Icon("link")<span>@L["Banking.AccountEdit.Reconnect"]</span></a>
        }
    </mb-card>

    @if (Model.Imports.Count > 0)
    {
        <mb-card title="@L["Banking.AccountEdit.Imports"]" icon="history">
            <ul class="mb-notes">
                @foreach (var i in Model.Imports)
                {
                    <li class="mb-note">
                        @Ui.Icon("upload", "mb-note__icon mb-note__icon--info")
                        <div class="mb-note__body"><span>@L["Banking.AccountEdit.ImportLine", i.FileName ?? i.Source, i.Added, i.Duplicates, i.Matched]</span><span class="mb-note__meta">@Fmt.Moment(i.ImportDate) · @i.Source</span></div>
                    </li>
                }
            </ul>
        </mb-card>
    }
}
