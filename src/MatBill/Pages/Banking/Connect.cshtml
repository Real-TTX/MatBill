@page
@model MatBill.Pages.Banking.ConnectModel

@if (!Model.Configured)
{
    <div class="mat-alert mat-alert--info" role="note">@Ui.Icon("info")<div class="mat-alert__body">@L["Banking.Connect.NotConfigured.Before"] <a href="/Admin/Banking">@L["Banking.Connect.NotConfigured.Settings"]</a>@L["Banking.Connect.NotConfigured.Middle"] <a href="/Banking/Import">@L["Banking.Connect.NotConfigured.Import"]</a> @L["Banking.Connect.NotConfigured.After"]</div></div>
}
else
{
    @if (Model.Problem is not null)
    {
        <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("x-circle")<div class="mat-alert__body">@Model.Problem</div></div>
    }

    <form method="get" class="mat-toolbar" role="toolbar" aria-label="@L["Banking.Connect.CountryToolbar"]">
        <div class="mat-field">
            <label class="mat-label" for="country">@L["Banking.Connect.Country"]</label>
            <select class="mat-select" id="country" name="country" data-submit-on-change>
                @foreach (var code in new[] { "DE", "AT", "CH", "NL", "FR", "BE", "LU", "IT", "ES", "PL", "DK", "SE", "FI" })
                {
                    <option value="@code" selected="@(Model.Country == code)">@L["Banking.Country." + code]</option>
                }
            </select>
        </div>
    </form>

    <form method="post" class="mat-form" novalidate>
        <input type="hidden" name="Country" value="@Model.Country" />
        <mb-card title="@L["Banking.Connect.ChooseBank"]" icon="building" sub="@L["Banking.Connect.BankCount", Model.Banks.Count]">
            <div class="mat-field">
                <label class="mat-label" for="Bank">@L["Banking.AccountEdit.Bank"]</label>
                <div class="mat-picker" data-picker="select" data-search data-placeholder="@L["Banking.Connect.SearchBank"]">
                    <input class="mat-picker__input" id="Bank" name="Bank" required data-msg-required="@L["Banking.Connect.BankRequired"]" />
                    <div class="mat-picker__options" hidden>
                        @foreach (var b in Model.Banks)
                        {
                            <button type="button" class="mat-picker__option" data-value="@b.Name"><span class="mat-picker__text"><span class="mat-picker__name">@b.Name</span>@if (b.Bic is not null) { <span class="mat-picker__desc">@b.Bic</span> }</span></button>
                        }
                    </div>
                </div>
            </div>
            <p class="mat-hint">@L["Banking.Connect.Hint"]</p>
        </mb-card>
        <div class="mat-btn-row">
            <button type="submit" class="mat-btn mat-btn--primary mb-needs-online" disabled="@(Model.Banks.Count == 0)">@Ui.Icon("external")<span>@L["Banking.Connect.ToBank"]</span></button>
            <a class="mat-btn mat-btn--secondary" href="/Banking">@Ui.Icon("back")<span>@L["Common.Back"]</span></a>
        </div>
    </form>
}
