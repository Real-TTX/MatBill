@using MatBill.Core.Billing
@model (LineInput Line, int Index, bool TaxExempt)
@*
    One position of the editable document. Its fields carry data-field; app.js names them after their place (Input.Lines[2].Name) whenever positions are
    added, moved or removed. A position drawn by the server already has its names (it works without the script); the template (Index -1) has none.
    The labels are for the form view and screen readers (interface language); data-text keeps "{n}" for app.js to put in the number.
*@
@{
    var l = Model.Line;
    var i = Model.Index;
    string? N(string field) => i < 0 ? null : $"Input.Lines[{i}].{field}";
    string? Id(string field) => i < 0 ? null : $"line-{i}-{field}";
    var n = i + 1;
    var rate = l.TaxRate ?? "19";
    var rates = InvoiceMath.CommonTaxRates.Select(r => Amount.Quantity(r)).ToList();
    if (!rates.Contains(rate)) { rates.Insert(0, rate); }
    var error = (string field) => i < 0 ? null : ViewContext.ViewData.ModelState[$"Input.Lines[{i}].{field}"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string nameText = L["Editor.Line.Name"], descriptionText = L["Editor.Line.Description"];
}
<div class="mb-line" data-line role="listitem" aria-label="@L["Editor.Line", n]">
    <div class="mb-line__what">
        <input type="hidden" data-field="ProductId" name="@N("ProductId")" id="@Id("ProductId")" value="@l.ProductId" />
        <div class="mb-field mb-combo">
            <label class="mb-label" data-for="Name" data-text="@nameText" for="@Id("Name")">@nameText.Replace("{n}", n.ToString())</label>
            <input class="mb-in mb-in--strong" data-field="Name" name="@N("Name")" id="@Id("Name")" value="@l.Name" placeholder="@L["Editor.Line.Name.Placeholder"]" maxlength="300" aria-invalid="@(error("Name") is null ? null : "true")" />
        </div>
        <div class="mb-field">
            <label class="mb-label" data-for="Description" data-text="@descriptionText" for="@Id("Description")">@descriptionText.Replace("{n}", n.ToString())</label>
            <textarea class="mb-in mb-in--small" data-field="Description" name="@N("Description")" id="@Id("Description")" rows="1" data-autogrow maxlength="2000" placeholder="@L["Editor.Line.Description.Placeholder"]">@l.Description</textarea>
        </div>
    </div>
    <div class="mb-line__qty">
        <div class="mb-field">
            <label class="mb-label" data-for="Quantity" data-text="@L["Editor.Line.Quantity"]" for="@Id("Quantity")">@L["Editor.Line.Quantity"]</label>
            <input class="mb-in mb-in--num" data-field="Quantity" name="@N("Quantity")" id="@Id("Quantity")" value="@l.Quantity" inputmode="decimal" placeholder="1" maxlength="20" aria-invalid="@(error("Quantity") is null ? null : "true")" />
        </div>
        <div class="mb-field">
            <label class="mb-label" data-for="Unit" data-text="@L["Editor.Line.Unit"]" for="@Id("Unit")">@L["Editor.Line.Unit"]</label>
            <input class="mb-in" data-field="Unit" name="@N("Unit")" id="@Id("Unit")" value="@l.Unit" placeholder="@L["Editor.Line.Unit"]" maxlength="30" />
        </div>
    </div>
    <div class="mb-line__price mb-field">
        <label class="mb-label" data-for="UnitPrice" data-text="@L[Model.TaxExempt ? "Editor.Line.UnitPrice.Exempt" : "Editor.Line.UnitPrice"]" for="@Id("UnitPrice")">@L[Model.TaxExempt ? "Editor.Line.UnitPrice.Exempt" : "Editor.Line.UnitPrice"]</label>
        <input class="mb-in mb-in--num" data-field="UnitPrice" name="@N("UnitPrice")" id="@Id("UnitPrice")" value="@l.UnitPrice" inputmode="decimal" placeholder="0,00" maxlength="20" aria-invalid="@(error("UnitPrice") is null ? null : "true")" />
    </div>
    <div class="mb-line__tax mb-field">
        <label class="mb-label" data-for="TaxRate" data-text="@L["Editor.Line.Tax"]" for="@Id("TaxRate")">@L["Editor.Line.Tax"]</label>
        <select class="mb-in mb-in--num" data-field="TaxRate" name="@N("TaxRate")" id="@Id("TaxRate")" disabled="@Model.TaxExempt">
            @foreach (var r in rates)
            {
                <option value="@r" selected="@(r == rate)">@r %</option>
            }
        </select>
    </div>
    <div class="mb-line__total" data-line-total>@DocFmt.Money(DocumentInputs.LineNet(l))</div>
    <div class="mb-line__tools">
        <div class="mb-line__more">
            <button type="button" class="mb-tool" data-line-more aria-haspopup="true" aria-expanded="false" aria-label="@L["Editor.Line.Actions"]">@Ui.Icon("more-horizontal")</button>
            <div class="mb-line__menu" hidden>
                <button type="button" data-line-action="up">@Ui.Icon("arrow-up")<span>@L["Editor.Line.Up"]</span></button>
                <button type="button" data-line-action="down">@Ui.Icon("arrow-down")<span>@L["Editor.Line.Down"]</span></button>
                <button type="button" data-line-action="copy">@Ui.Icon("copy")<span>@L["Editor.Line.Duplicate"]</span></button>
                <button type="button" data-line-action="remove" class="is-danger">@Ui.Icon("trash")<span>@L["Editor.Line.Remove"]</span></button>
            </div>
        </div>
    </div>
</div>
