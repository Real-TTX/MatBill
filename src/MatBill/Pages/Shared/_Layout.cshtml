@inject IconSprite Sprite
@inject ShellFactory ShellFactory
@{
    // A page fills these in: Title, PageSub, Crumbs (the breadcrumb below the app name), Width ("narrow" or "wide"), ActiveHref (the menu item it belongs to).
    // A page that draws its own head sets OwnHead.
    var shell = await ShellFactory.BuildAsync();
    var title = ViewData["Title"] as string ?? "MatBill";
    var ownHead = ViewData["OwnHead"] is true;
    var sub = ViewData["PageSub"] as string;
    var crumbs = ViewData["Crumbs"] as IReadOnlyList<(string Text, string? Url)> ?? [];
    var width = ViewData["Width"] as string;
    var active = ViewData["ActiveHref"] as string ?? Navigation.ActiveHref(shell.Menus, Context.Request.Path.Value ?? "/");
    // The first label of the theme button; MatUi writes it anew (in the language of <html lang>) as soon as the script runs.
    var themeLabel = L["Shell.Theme.Toggle", L["Common.Theme.System"].Value, L["Common.Theme.Light"].Value].Value;
}
<!DOCTYPE html>
<html @ClientTexts.RootAttributes() data-app="matbill" data-sw="@(AppVersion.Current)-@(Sprite.Hash)" @Html.Raw(shell.RootAttributes)>
<partial name="_Head" model="(shell, title)" />
<body>
    <a class="mat-skip" href="#main">@L["Shell.SkipToContent"]</a>
    @Html.Raw(Sprite.Html)

    <div class="mat-app">
        <aside class="mat-nav" id="mat-nav">
            <div class="mat-nav__brand">
                <a href="@shell.HomeHref" aria-label="@L["Shell.HomeLabel"]">
                    @Ui.Logo()
                    <span>
                        <span class="mat-nav__name">MatBill</span>
                        <span class="mat-nav__tagline">@shell.Tagline</span>
                    </span>
                </a>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-nav__close" data-nav-close aria-label="@L["Shell.CloseMenu"]">@Ui.Icon("x")</button>
            </div>

            <partial name="_Menu" model="(shell, active)" />

            <div class="mat-nav__foot">
                @if (shell.HasSwitcher)
                {
                    <partial name="_MenuSwitcher" model="(shell, active)" />
                }
                <div class="mat-nav__account">
                    <button type="button" class="mat-user" data-menu-toggle="user-menu" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-avatar" aria-hidden="true">@Ui.Initials(shell.UserName)</span>
                        <span class="mat-user__text">
                            <span class="mat-user__name">@shell.UserName</span>
                            <span class="mat-user__role">@shell.UserRole</span>
                        </span>
                        @Ui.Icon("chevron-up", "mat-user__chev")
                    </button>
                    <button type="button" class="mat-theme" data-theme-toggle data-theme-save-url="/api/theme" data-theme-state="system" aria-label="@themeLabel" title="@themeLabel">
                        <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                        <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                        <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
                    </button>
                </div>
                <div class="mat-nav__version">@shell.Version</div>
            </div>
        </aside>

        <div class="mat-main">
            <header class="mat-topbar">
                <button type="button" class="mat-burger" data-nav-toggle aria-label="@L["Shell.OpenMenu"]" aria-controls="mat-nav" aria-expanded="false">@Ui.Icon("menu")</button>
                <nav class="mat-crumbs" aria-label="@L["Shell.Breadcrumb"]">
                    <ol>
                        @if (crumbs.Count == 0)
                        {
                            <li aria-current="page">MatBill</li>
                        }
                        else
                        {
                            <li><a href="@shell.HomeHref">MatBill</a></li>
                            @for (var i = 0; i < crumbs.Count; i++)
                            {
                                var c = crumbs[i];
                                if (i == crumbs.Count - 1 || c.Url is null)
                                {
                                    <li aria-current="page">@c.Text</li>
                                }
                                else
                                {
                                    <li><a href="@c.Url">@c.Text</a></li>
                                }
                            }
                        }
                    </ol>
                </nav>
                <div class="mat-topbar__actions">
                    @await RenderSectionAsync("TopbarActions", required: false)
                    @if (shell.Unread is { } unread)
                    {
                        <a class="mat-btn mat-btn--ghost mat-btn--icon mb-bell" href="/Notifications" data-tip="@L["Shell.Notifications"]" aria-label="@(unread > 0 ? L["Shell.NotificationsUnread", unread] : L["Shell.Notifications"])">
                            @Ui.Icon("bell")
                            @if (unread > 0) { <span class="mat-badge mb-bell__count" aria-hidden="true">@(unread > 99 ? "99+" : unread.ToString())</span> }
                        </a>
                    }
                </div>
            </header>

            @* Shown by app.js while there is no connection; the page stays usable to read, saving waits for the connection. *@
            <div class="mat-alert mat-alert--warning mb-offline" role="status" data-offline-banner hidden>
                @Ui.Icon("wifi-off")
                <div class="mat-alert__body"><strong>@L["Shell.Offline.Title"]</strong> <span data-offline-text>@L["Shell.Offline.Text"]</span></div>
                <div class="mat-alert__actions"><button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-reconnect>@Ui.Icon("refresh")<span>@L["Shell.Reconnect"]</span></button></div>
            </div>

            <main class="mat-page @(width == "narrow" ? "mat-page--narrow" : width == "wide" ? "mat-page--wide" : "")" id="main">
                @if (!ownHead)
                {
                    <div class="mat-page__head">
                        <div class="mat-page__title">
                            <h1>@title</h1>
                            @if (!string.IsNullOrEmpty(sub))
                            {
                                <p class="mat-page__sub">@sub</p>
                            }
                        </div>
                    </div>
                }

                @RenderBody()
            </main>

            <footer class="mat-footer">
                <p class="mat-footer__text">@L["Shell.Footer"]</p>
            </footer>
        </div>
    </div>

    <div class="mat-menu" id="user-menu" role="menu" aria-label="@shell.UserName" hidden>
        <div class="mat-menu__head">
            <span class="mat-avatar" aria-hidden="true">@Ui.Initials(shell.UserName)</span>
            <div><strong>@shell.UserName</strong><small>@shell.UserLine</small></div>
        </div>
        @foreach (var item in shell.UserMenu)
        {
            if (item.SeparatorBefore)
            {
                <div class="mat-menu__sep" role="separator"></div>
            }

            if (item.Post)
            {
                <form method="post" action="@item.Href">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="mat-menu__item @(item.Danger ? "mat-menu__item--danger" : "")" role="menuitem">@Ui.Icon(item.Icon)<span>@item.Title</span></button>
                </form>
            }
            else
            {
                <a class="mat-menu__item @(item.Danger ? "mat-menu__item--danger" : "")" role="menuitem" href="@item.Href">@Ui.Icon(item.Icon)<span>@item.Title</span></a>
            }
        }
    </div>

    <partial name="_MenuSwitchPopup" model="(shell, active)" />

    @* After a save the page redirects and shows what was done as a toast. *@
    @if (TempData["Flash"] is string flash)
    {
        <div data-toast="@flash" data-tone="success" hidden></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div data-toast="@error" data-tone="error" hidden></div>
    }

    <partial name="_Preview" />
    @ClientTexts.Script()
    <script src="~/ui/matui.js?v=@Sprite.Hash"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
