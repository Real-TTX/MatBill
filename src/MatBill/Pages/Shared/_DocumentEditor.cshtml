@using MatBill.Core.Billing
@model DocumentEditorModel
@*
    The editable A4 document: every value is a field at the place where it stands on the paper. It is drawn inside the page's form; app.js adds the
    suggestions (customers, products), the positions and the sums. In the form view (data-view="form" on the editor) the same fields become an ordinary form.
    Every field has its label: hidden on the paper (the paper itself says what a value is), visible in the form.
    The paper is the document the customer gets and stays German (captions, sums, stamp, default values, DocFmt); what only the writer sees
    (labels of the form view, placeholders, hints, aria labels) follows the language of the interface.
*@
@{
    var input = Model.Input;
    var company = Model.Company;
    var template = Model.Mode == EditorMode.Template;
    var quote = Model.Mode == EditorMode.Quote;
    var totals = DocumentInputs.Totals(input, Model.TaxExempt);
    var rates = InvoiceMath.CommonTaxRates;
    var lines = input.Lines.ToList();
    var blank = new LineInput { Quantity = "1", TaxRate = Amount.Quantity(Model.Invoicing.DefaultTaxRate) };
    var senderLines = new[] { company.NameLine2, company.Street, string.Join(" ", new[] { company.PostalCode, company.City }.Where(s => !string.IsNullOrWhiteSpace(s))), company.Email, company.Phone, company.Website }
        .Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
    var termDays = $"<span data-term-days>{input.PaymentTermDays ?? Model.Invoicing.PaymentTermDays}</span>";
    // the paper says what it means: 1 Tag, 14 Tage, and for 0 days an invoice is due at once
    string DaysUnit(int days) => days == 1 ? "Tag" : days == 0 && !quote ? "Tage (sofort)" : "Tage";
}

<article class="mb-paper mb-doc @(Model.Stamp is null ? "" : "is-draft") @(Model.TaxExempt ? "is-exempt" : "")" data-stamp="@Model.Stamp" aria-label="@(template ? L["Editor.Aria.Template"] : quote ? L["Editor.Aria.Quote"] : L["Editor.Aria.Invoice"])">
    <header class="mb-doc__head mb-doc__head--@MatBill.Configuration.DocumentLayouts.Of(company.Layout)">
        <div class="mb-doc__logo">
            @if (Model.LogoUrl is not null)
            {
                <img src="@Model.LogoUrl" alt="@company.Name" />
            }
            else
            {
                <div class="mb-doc__company">@(string.IsNullOrWhiteSpace(company.Name) ? L["Editor.CompanyPlaceholder"] : company.Name)</div>
            }
            @if (Model.CanEditBranding && (Model.LogoUrl is null || string.IsNullOrWhiteSpace(company.Name)))
            {
                <a class="mb-doc__brandlink" href="@(string.IsNullOrWhiteSpace(company.Name) ? "/Admin/Company" : "/Admin/Branding")">@(string.IsNullOrWhiteSpace(company.Name) ? L["Editor.CompanyLink"] : L["Editor.BrandingLink"])</a>
            }
        </div>
        <address class="mb-doc__sender">
            <strong>@company.Name</strong>@foreach (var line in senderLines) { <span>@line</span> }
        </address>
    </header>

    <div class="mb-doc__top">
        <section class="mb-doc__part mb-doc__recipient" aria-labelledby="doc-to">
            <div class="mb-doc__senderline">@company.SenderLine</div>
            <span class="mb-doc__caption mb-doc__to" id="doc-to">An</span>
            <input type="hidden" name="Input.CustomerId" value="@input.CustomerId" />
            <div class="mb-doc__address">
                <div class="mb-field mb-combo">
                    <label class="mb-label" for="Input_RecipientName">@L["Editor.Recipient"]</label>
                    <div class="mb-combo__row">
                    <input class="mb-in mb-in--strong" id="Input_RecipientName" name="Input.RecipientName" value="@input.RecipientName" placeholder="@L["Editor.Recipient.Placeholder"]" autocomplete="off" maxlength="200"
                           aria-describedby="Input_RecipientName-error" aria-invalid="@(ViewData.ModelState["Input.RecipientName"]?.Errors.Count > 0 ? "true" : null)" />
                    <button type="button" class="mb-lookup-btn" data-lookup-open="customers" data-tip="@L["Editor.Lookup.Customers"]" aria-label="@L["Editor.Lookup.Customers"]">@Ui.Icon("search")</button>
                    </div>
                    <span class="mat-error" id="Input_RecipientName-error" aria-live="polite">@ViewData.ModelState["Input.RecipientName"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                </div>
                <p class="mat-hint" data-new-customer-hint hidden>@(template ? L["Editor.Recipient.FromList"] : L["Editor.Recipient.New"])</p>
                @if (!template)
                {
                    <div class="mb-field"><label class="mb-label" for="Input_RecipientContact">@L["Editor.Contact"]</label><input class="mb-in" id="Input_RecipientContact" name="Input.RecipientContact" value="@input.RecipientContact" placeholder="@L["Editor.Contact.Placeholder"]" maxlength="200" /></div>
                    <div class="mb-field"><label class="mb-label" for="Input_RecipientStreet">@L["Editor.Street"]</label><input class="mb-in" id="Input_RecipientStreet" name="Input.RecipientStreet" value="@input.RecipientStreet" placeholder="@L["Editor.Street.Placeholder"]" maxlength="200" autocomplete="off" /></div>
                    <div class="mb-pair">
                        <div class="mb-field"><label class="mb-label" for="Input_RecipientPostalCode">@L["Editor.PostalCode"]</label><input class="mb-in" id="Input_RecipientPostalCode" name="Input.RecipientPostalCode" value="@input.RecipientPostalCode" placeholder="@L["Editor.PostalCode"]" maxlength="20" inputmode="numeric" autocomplete="off" /></div>
                        <div class="mb-field"><label class="mb-label" for="Input_RecipientCity">@L["Editor.City"]</label><input class="mb-in" id="Input_RecipientCity" name="Input.RecipientCity" value="@input.RecipientCity" placeholder="@L["Editor.City"]" maxlength="100" autocomplete="off" /></div>
                    </div>
                    <div class="mb-field"><label class="mb-label" for="Input_RecipientCountry">@L["Editor.Country"]</label><input class="mb-in mb-in--small" id="Input_RecipientCountry" name="Input.RecipientCountry" value="@(input.RecipientCountry ?? "Deutschland")" maxlength="100" /></div>
                    <div class="mb-field"><label class="mb-label" for="Input_RecipientEmail">@L["Editor.Email"]</label><input class="mb-in mb-in--small" type="email" inputmode="email" id="Input_RecipientEmail" name="Input.RecipientEmail" value="@input.RecipientEmail" placeholder="@L["Editor.Email.Placeholder"]" maxlength="200" /></div>
                }
                else
                {
                    <p class="mat-hint">@L["Editor.TemplateAddress"]</p>
                }
            </div>
        </section>

        <section class="mb-doc__part mb-doc__meta" aria-label="@L["Editor.Meta"]">
            <span class="mb-doc__caption mb-label">@L["Editor.Meta"]</span>
            <div class="mb-field"><label class="mb-label" for="Input_Title">@L["Editor.Title"]</label><input class="mb-in mb-in--title mb-doc__title" id="Input_Title" name="Input.Title" value="@(input.Title ?? (quote ? "Angebot" : "Rechnung"))" maxlength="80" /></div>
            <dl class="mb-doc__facts">
                <div>
                    <dt>@(quote ? "Angebotsnummer" : "Rechnungsnummer")</dt>
                    <dd class="is-muted" title="@L["Editor.Number.Tip"]">@(template ? L["Editor.Number.Sequential"] : Model.NumberPreview ?? L["Editor.Number.OnIssue"])</dd>
                </div>
                @if (template)
                {
                    <div><dt>Rechnungsdatum</dt><dd class="is-muted">@L["Editor.RunDay"]</dd></div>
                    <div><dt>Leistungszeitraum</dt><dd class="is-muted">@(Model.StatePeriod ? L["Editor.IntervalPeriod"] : L["Editor.RunDay"])</dd></div>
                }
                else
                {
                    <div>
                        <dt><label for="Input_InvoiceDate">@(quote ? "Angebotsdatum" : "Rechnungsdatum")</label></dt>
                        <dd><div class="mat-picker" data-picker="date"><input class="mat-picker__input" id="Input_InvoiceDate" name="Input.InvoiceDate" value="@Fmt.Iso(input.InvoiceDate)" required data-msg-required="@L["Editor.Date.Required"]" /></div></dd>
                    </div>
                }
                @if (Model.Mode == EditorMode.Invoice)
                {
                    <div>
                        <dt><label for="Input_ServiceFrom">Leistungsdatum</label></dt>
                        <dd><div class="mat-picker" data-picker="date" data-clearable data-placeholder="@L["Editor.Service.SameAsDate"]"><input class="mat-picker__input" id="Input_ServiceFrom" name="Input.ServiceFrom" value="@Fmt.Iso(input.ServiceFrom)" /></div></dd>
                    </div>
                    <div>
                        <dt><label for="Input_ServiceTo">Leistung bis</label></dt>
                        <dd><div class="mat-picker" data-picker="date" data-clearable data-placeholder="@L["Common.Optional"]"><input class="mat-picker__input" id="Input_ServiceTo" name="Input.ServiceTo" value="@Fmt.Iso(input.ServiceTo)" /></div></dd>
                    </div>
                }
                <div>
                    <dt><label for="Input_PaymentTermDays">@(quote ? "Gültigkeit" : "Zahlungsziel")</label></dt>
                    <dd><span class="mb-doc__inline"><input class="mb-in mb-in--num mb-in--days" type="number" min="0" max="365" step="1" inputmode="numeric" id="Input_PaymentTermDays" name="Input.PaymentTermDays" value="@(input.PaymentTermDays ?? (quote ? Model.Invoicing.QuoteValidityDays : Model.Invoicing.PaymentTermDays))" /> <span data-days-unit data-one="Tag" data-many="Tage" data-zero="@(quote ? "Tage" : "Tage (sofort)")">@DaysUnit(input.PaymentTermDays ?? (quote ? Model.Invoicing.QuoteValidityDays : Model.Invoicing.PaymentTermDays))</span></span></dd>
                </div>
                @if (!template)
                {
                    <div><dt>@(quote ? "Gültig bis" : "Fällig am")</dt><dd data-due>@(input.InvoiceDate is { } d ? DocFmt.Date(InvoiceMath.DueDate(d, input.PaymentTermDays ?? 0)) : "–")</dd></div>
                }
            </dl>
        </section>
    </div>

    <div class="mb-doc__intro">
        <label class="mb-label" for="Input_IntroText">@L["Editor.Intro"]</label>
        <textarea class="mb-in" id="Input_IntroText" name="Input.IntroText" rows="2" data-autogrow maxlength="4000" placeholder="@L["Editor.Intro.Placeholder"]">@input.IntroText</textarea>
    </div>

    <div class="mb-lines" data-lines data-caption="@L["Editor.Lines"]">
        <div class="mb-lines__head" aria-hidden="true"><span>Leistung</span><span>Menge</span><span>Einzelpreis</span><span class="mb-lines__tax">USt.</span><span>Gesamtpreis</span><span></span></div>
        <div class="mb-lines__body" data-lines-body role="list" aria-label="@L["Editor.Lines"]">
            @for (var i = 0; i < lines.Count; i++)
            {
                <partial name="_DocumentLine" model="(lines[i], i, Model.TaxExempt)" />
            }
        </div>
        <p class="mb-lines__empty" data-lines-empty hidden="@(lines.Count > 0)">@L["Editor.Lines.Empty"]</p>
        <template data-line-template><partial name="_DocumentLine" model="(blank, -1, Model.TaxExempt)" /></template>
        <button type="button" class="mb-add" data-line-add>@Ui.Icon("plus")<span>@L["Editor.Lines.Add"]</span></button>
    </div>

    <dl class="mb-doc__totals" aria-live="polite">
        <div hidden="@Model.TaxExempt"><dt>Zwischensumme</dt><dd data-sum-net>@DocFmt.Money(totals.Net)</dd></div>
        <div data-tax-rows class="mb-doc__taxes">
            @foreach (var g in totals.Taxes.Where(t => t.Rate > 0))
            {
                <div><dt>@(totals.Taxes.Count(t => t.Rate > 0) > 1 ? $"Umsatzsteuer {Amount.Quantity(g.Rate)} % auf {DocFmt.Money(g.Net)}" : $"Umsatzsteuer ({Amount.Quantity(g.Rate)} %)")</dt><dd>@DocFmt.Money(g.Tax)</dd></div>
            }
        </div>
        <div class="mb-doc__grand"><dt>Gesamtbetrag</dt><dd data-sum-gross>@DocFmt.Money(totals.Gross)</dd></div>
    </dl>
    @if (Model.TaxExempt)
    {
        <p class="mb-doc__note">@Model.Invoicing.SmallBusinessNote</p>
    }

    <div class="mb-doc__terms">
        <label class="mb-doc__caption" for="Input_PaymentTerms">@(quote ? "Bedingungen" : "Zahlungsbedingungen")</label>
        <textarea class="mb-in" id="Input_PaymentTerms" name="Input.PaymentTerms" rows="2" data-autogrow maxlength="2000" placeholder="@L["Editor.Terms.Placeholder"]" aria-describedby="terms-hint">@input.PaymentTerms</textarea>
        @if (quote)
        {
            <span class="mat-hint" id="terms-hint">@L["Editor.Terms.QuoteHint"]</span>
        }
        else
        {
            <span class="mat-hint" id="terms-hint">@Html.Raw(L["Editor.Terms.Hint", termDays].Value)</span>
        }
    </div>

    <div class="mb-doc__closing">
        <div class="mb-field">
            <label class="mb-label" for="Input_ClosingText">@L["Editor.Closing"]</label>
            <textarea class="mb-in" id="Input_ClosingText" name="Input.ClosingText" rows="1" data-autogrow maxlength="2000" placeholder="@L["Editor.Closing.Placeholder"]">@input.ClosingText</textarea>
        </div>
        @if (!string.IsNullOrWhiteSpace(company.Signature))
        {
            <span class="mb-doc__signature" aria-hidden="true">@company.Signature</span>
        }
    </div>

    <footer class="mb-doc__foot">
        <div class="mb-doc__footcols">
            <p>@company.SenderLine@if (!string.IsNullOrWhiteSpace(company.Manager)) { <br />@company.Manager }@if (!string.IsNullOrWhiteSpace(company.Register)) { <br />@company.Register }</p>
            <p>@company.BankName@if (!string.IsNullOrWhiteSpace(company.Iban)) { <br />@("IBAN " + company.Iban) }@if (!string.IsNullOrWhiteSpace(company.Bic)) { <br />@("BIC " + company.Bic) }</p>
            <p>@if (!string.IsNullOrWhiteSpace(company.TaxNumber)) { @("Steuernummer " + company.TaxNumber)<br /> }@if (!string.IsNullOrWhiteSpace(company.VatId)) { @("USt-IdNr. " + company.VatId) }</p>
        </div>
    </footer>
</article>

@* The detail search beside the paper (a dialog from the side): customers or products, searched by the database page by page; a choice fills the recipient or the position.
   Its fields belong to no form (form="mb-lookup-none"), so they are never posted and Enter does not send the document. *@
<dialog class="mat-dialog mat-dialog--end" id="mb-lookup" aria-labelledby="mb-lookup-title" data-lookup-dialog
        data-title-customers="@L["Editor.Lookup.Customers"]" data-title-products="@L["Editor.Lookup.Products"]">
    <div class="mat-dialog__form">
        <div class="mat-dialog__head">
            @Ui.Icon("search")
            <h2 class="mat-dialog__title" id="mb-lookup-title" data-lookup-title>@L["Editor.Lookup.Customers"]</h2>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="@L["Common.Close"]">@Ui.Icon("x")</button>
        </div>
        <div class="mat-dialog__body mat-form mb-lookup">
            <div class="mat-field">
                <label class="mat-label" for="mb-lookup-q">@L["Editor.Lookup.Search"]</label>
                <input class="mat-input" type="search" id="mb-lookup-q" form="mb-lookup-none" autocomplete="off" data-lookup-q />
            </div>
            <div class="mb-lookup__filters">
                <div class="mat-field" data-lookup-only="customers">
                    <label class="mat-label" for="mb-lookup-city">@L["Editor.Lookup.City"]</label>
                    <input class="mat-input" id="mb-lookup-city" form="mb-lookup-none" autocomplete="off" data-lookup-filter="city" />
                </div>
                <div class="mat-field" data-lookup-only="customers">
                    <label class="mat-label" for="mb-lookup-ckind">@L["Editor.Lookup.Kind"]</label>
                    <select class="mat-select" id="mb-lookup-ckind" form="mb-lookup-none" data-lookup-filter="kind">
                        <option value="">@L["Common.All"]</option>
                        @foreach (var k in Enum.GetValues<CustomerKind>()) { <option value="@k">@Labels.Of(k)</option> }
                    </select>
                </div>
                <div class="mat-field" data-lookup-only="products">
                    <label class="mat-label" for="mb-lookup-pkind">@L["Editor.Lookup.Kind"]</label>
                    <select class="mat-select" id="mb-lookup-pkind" form="mb-lookup-none" data-lookup-filter="kind">
                        <option value="">@L["Common.All"]</option>
                        @foreach (var k in Enum.GetValues<ProductKind>()) { <option value="@k">@Labels.Of(k)</option> }
                    </select>
                </div>
            </div>
            <p class="mat-hint" data-lookup-count aria-live="polite"></p>
            <ul class="mat-itemlist mb-lookup__list" data-lookup-list></ul>
            <button type="button" class="mat-btn mat-btn--secondary" data-lookup-more hidden>@Ui.Icon("chevron-down")<span>@L["Editor.Lookup.More"]</span></button>
        </div>
    </div>
</dialog>
