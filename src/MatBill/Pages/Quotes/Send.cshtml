@page
@model MatBill.Pages.Quotes.SendModel

@if (!Model.Configured)
{
    <div class="mat-alert mat-alert--warning" role="status">
        @Ui.Icon("alert")
        <div class="mat-alert__body">
            <strong>Es ist noch kein Mailserver eingerichtet.</strong>
            @if (Model.IsAdmin)
            {
                <span>Richte ihn unter <a href="/Admin/Mail">Einstellungen &gt; E-Mail</a> ein. Bis dahin kannst du die <a href="/quotes/@Model.Quote.Id/pdf?download=1">PDF herunterladen</a> und selbst versenden.</span>
            }
            else
            {
                <span>Ein Administrator muss ihn einrichten. Bis dahin kannst du die <a href="/quotes/@Model.Quote.Id/pdf?download=1">PDF herunterladen</a> und selbst versenden.</span>
            }
        </div>
    </div>
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <mb-summary title="Das Angebot wurde nicht versendet." />
    <mb-card title="E-Mail" icon="mail">
        <div class="mat-form__grid">
            <mb-input for="Input.To" label="An" type="text" inputmode="email" required="true" full="true" hint="Mehrere Adressen mit Komma trennen." autocomplete="off" />
            <mb-input for="Input.Cc" label="Kopie an (CC)" type="text" inputmode="email" full="true" autocomplete="off" />
            <mb-input for="Input.Subject" label="Betreff" required="true" full="true" />
            <mb-textarea for="Input.Body" label="Text" rows="9" required="true" full="true" />
        </div>
        <p class="mat-hint">Anhang: <a href="/quotes/@Model.Quote.Id/pdf" target="_blank" rel="noopener">@QuoteService.PdfName(Model.Quote)</a></p>
    </mb-card>
    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary mb-needs-online" disabled="@(!Model.Configured)">@Ui.Icon("send")<span>Senden</span></button>
        <a class="mat-btn mat-btn--secondary" href="/Quotes/Edit?id=@Model.Id">@Ui.Icon("back")<span>Zurück</span></a>
    </div>
</form>
