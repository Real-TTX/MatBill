@page
@model MatBill.Pages.Quotes.SendModel
@{
    var pdfLink = $"<a href=\"/quotes/{Model.Quote.Id}/pdf?download=1\">{System.Net.WebUtility.HtmlEncode(L["Quotes.Send.DownloadPdf"].Value)}</a>";
    var mailLink = $"<a href=\"/Admin/Mail\">{System.Net.WebUtility.HtmlEncode(L["Quotes.Send.MailSettings"].Value)}</a>";
}

@if (!Model.Configured)
{
    <div class="mat-alert mat-alert--warning" role="status">
        @Ui.Icon("alert")
        <div class="mat-alert__body">
            <strong>@L["Quotes.Send.NoMail"]</strong>
            @if (Model.IsAdmin)
            {
                <span>@Html.Raw(L["Quotes.Send.NoMail.Admin", mailLink, pdfLink].Value)</span>
            }
            else
            {
                <span>@Html.Raw(L["Quotes.Send.NoMail.User", pdfLink].Value)</span>
            }
        </div>
    </div>
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <mb-summary title="@L["Quotes.Send.NotSent"]" />
    <mb-card title="@L["Common.Email"]" icon="mail">
        <div class="mat-form__grid">
            <mb-input for="Input.To" label="@L["Quotes.Send.To"]" type="text" inputmode="email" required="true" full="true" hint="@L["Quotes.Send.To.Hint"]" autocomplete="off" />
            <mb-input for="Input.Cc" label="@L["Quotes.Send.Cc"]" type="text" inputmode="email" full="true" autocomplete="off" />
            <mb-input for="Input.Subject" label="@L["Quotes.Send.Subject"]" required="true" full="true" />
            <mb-textarea for="Input.Body" label="@L["Quotes.Send.Body"]" rows="9" required="true" full="true" />
        </div>
        <p class="mat-hint">@L["Quotes.Send.Attachment"] <a href="/quotes/@Model.Quote.Id/pdf?download=1">@QuoteService.PdfName(Model.Quote)</a></p>
    </mb-card>
    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary mb-needs-online" disabled="@(!Model.Configured)">@Ui.Icon("send")<span>@L["Quotes.Send.Send"]</span></button>
        <a class="mat-btn mat-btn--secondary" href="/Quotes/Edit?id=@Model.Id">@Ui.Icon("back")<span>@L["Common.Back"]</span></a>
    </div>
</form>
