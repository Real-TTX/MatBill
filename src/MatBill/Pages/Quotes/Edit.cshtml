@page
@model MatBill.Pages.Quotes.EditModel
@{
    var quote = Model.Quote;
    var draft = quote.IsDraft;
}

<div class="mb-editor" data-editor data-view="@Model.EditorView" data-doc-accent="@Model.Editor?.Company.AccentColor" @(draft ? "" : "data-readonly")>
    <div class="mb-editor__head">
        <div class="mb-editor__title">
            <h1>@ViewData["Title"]</h1>
            @Labels.Pill(quote, Model.Today)
        </div>
        @if (draft)
        {
            <div class="mat-seg" role="group" aria-label="@L["Quotes.Editor.View"]">
                <button type="button" class="mat-seg__btn" data-view-set="document" aria-pressed="@(Model.EditorView == "document" ? "true" : "false")">@Ui.Icon("file-document")<span>@L["Quotes.Editor.Document"]</span></button>
                <button type="button" class="mat-seg__btn" data-view-set="form" aria-pressed="@(Model.EditorView == "form" ? "true" : "false")">@Ui.Icon("list")<span>@L["Quotes.Editor.Form"]</span></button>
            </div>
        }
    </div>

    @if (draft)
    {
        <form method="post" asp-page-handler="Save" asp-route-id="@quote.Id" novalidate>
            <mb-summary title="@L["Quotes.Editor.Check"]" />
            <div class="mat-alert mat-alert--info mb-restore" data-restore hidden>
                @Ui.Icon("history")
                <div class="mat-alert__body">@Html.Raw(L["Quotes.Editor.Restore", "<span data-restore-when></span>"].Value)</div>
                <div class="mat-alert__actions">
                    <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-restore-apply>@Ui.Icon("undo")<span>@L["Quotes.Editor.Restore.Apply"]</span></button>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-restore-discard>@L["Quotes.Editor.Restore.Discard"]</button>
                </div>
            </div>
            <div class="mb-editor__grid">
                <div class="mb-editor__main"><partial name="_DocumentEditor" model="Model.Editor" /></div>
                <aside class="mb-editor__side" aria-label="@L["Quotes.Editor.Hints"]">
                    <div class="mat-card">
                        <div class="mat-card__head">@Ui.Icon("info")<h2 class="mat-card__title">@L["Quotes.DraftTitle"]</h2></div>
                        <div class="mat-card__body">
                            <p class="mat-muted">@L["Quotes.Editor.DraftHint", Model.Editor!.NumberPreview]</p>
                        </div>
                    </div>
                </aside>
            </div>
            <div class="mat-btn-row mat-btn-row--sticky mb-editor__foot">
                <button type="submit" class="mat-btn mat-btn--primary" asp-page-handler="Issue" asp-route-id="@quote.Id" data-confirm="@L["Quotes.Issue.Confirm", Model.Editor.NumberPreview]" data-confirm-ok="@L["Quotes.Issue"]">@Ui.Icon("check")<span>@L["Quotes.Issue"]</span></button>
                <button type="submit" class="mat-btn mat-btn--secondary" asp-page-handler="Save" asp-route-id="@quote.Id">@Ui.Icon("save")<span>@L["Common.Save"]</span></button>
                @if (!Model.IsNew)
                {
                    <a class="mat-btn mat-btn--ghost" href="/quotes/@quote.Id/pdf?download=1" data-pdf-preview="/quotes/@quote.Id/preview">@Ui.Icon("eye")<span>@L["Quotes.PdfPreview"]</span></a>
                }
                <a class="mat-btn mat-btn--ghost" href="/Quotes">@Ui.Icon("back")<span>@L["Common.Back"]</span></a>
                @if (!Model.IsNew)
                {
                    <span class="mat-btn-row__spacer"></span>
                    <button type="submit" class="mat-btn mat-btn--danger" formnovalidate asp-page-handler="Delete" asp-route-id="@quote.Id" data-confirm="@L["Quotes.Delete.Confirm"]" data-confirm-ok="@L["Common.Delete"]">@Ui.Icon("trash")<span>@L["Common.Delete"]</span></button>
                }
            </div>
        </form>
        <script type="application/json" id="mb-editor-data">@Html.Raw(Model.EditorJson)</script>
    }
    else
    {
        <div class="mb-editor__grid">
            <div class="mb-editor__main"><partial name="_DocumentView" model="Model.View" /></div>
            <aside class="mb-editor__side" aria-label="@L["Quotes.Side.Status"]">
                <div class="mat-card">
                    <div class="mat-card__head">@Ui.Icon("info")<h2 class="mat-card__title">@L["Common.Status"]</h2>@Labels.Pill(quote, Model.Today)</div>
                    <div class="mat-card__body">
                        <dl class="mat-kv">
                            <dt>@L["Common.Amount"]</dt><dd>@Fmt.Money(quote.GrossTotal)</dd>
                            <dt>@L["Quotes.Side.Issued"]</dt><dd>@Fmt.Moment(quote.IssuedDate)</dd>
                            <dt>@L["Quotes.Column.ValidUntil"]</dt><dd class="@(quote.IsExpired(Model.Today) ? "mb-warn-text" : "")">@Fmt.Date(quote.ValidUntil)</dd>
                            @if (quote.AnsweredDate is not null) { <dt>@L["Quotes.Side.Answer"]</dt><dd>@L["Quotes.Side.AnswerOn", Labels.Of(quote.Status), Fmt.Date(quote.AnsweredDate)]</dd> }
                            @if (quote.SentDate is not null) { <dt>@L["Quotes.Side.Sent"]</dt><dd>@Fmt.Moment(quote.SentDate)</dd> }
                            @if (quote.InvoiceId is { } invoiceId) { <dt>@L["Quotes.Side.Invoice"]</dt><dd><a href="/Invoices/Edit?id=@invoiceId">@L["Quotes.Side.ToInvoice"]</a></dd> }
                            <dt>@L["Quotes.Column.Customer"]</dt><dd>@if (quote.Customer is not null) { <a href="/Customers/Edit?id=@quote.Customer.Id">@quote.Customer.Name</a> } else { @quote.RecipientName }</dd>
                        </dl>
                    </div>
                </div>
            </aside>
        </div>
        <form method="post" class="mat-btn-row mat-btn-row--sticky mb-editor__foot">
            @if (quote.Status is QuoteStatus.Open or QuoteStatus.Accepted)
            {
                <button type="submit" class="mat-btn mat-btn--primary" asp-page-handler="Invoice" asp-route-id="@quote.Id">@Ui.Icon("file-plus")<span>@L["Quotes.ToInvoice"]</span></button>
            }
            <a class="mat-btn mat-btn--secondary" href="/quotes/@quote.Id/pdf?download=1">@Ui.Icon("download")<span>PDF</span></a>
            @if (quote.Status != QuoteStatus.Invoiced)
            {
                <a class="mat-btn mat-btn--secondary" href="/Quotes/Send?id=@quote.Id">@Ui.Icon("send")<span>@L["Quotes.SendByMail"]</span></a>
            }
            @if (quote.Status == QuoteStatus.Open)
            {
                <button type="submit" class="mat-btn mat-btn--ghost" asp-page-handler="Accept" asp-route-id="@quote.Id">@Ui.Icon("check")<span>@L["Quotes.Accept"]</span></button>
            }
            <button type="submit" class="mat-btn mat-btn--ghost" asp-page-handler="Duplicate" asp-route-id="@quote.Id">@Ui.Icon("copy")<span>@L["Quotes.NewVersion"]</span></button>
            <a class="mat-btn mat-btn--ghost" href="/Quotes">@Ui.Icon("back")<span>@L["Common.Back"]</span></a>
            @if (quote.Status is QuoteStatus.Open or QuoteStatus.Accepted)
            {
                <span class="mat-btn-row__spacer"></span>
                <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Decline" asp-route-id="@quote.Id" data-confirm="@L["Quotes.Decline.Confirm"]" data-confirm-ok="@L["Quotes.Decline"]">@Ui.Icon("ban")<span>@L["Quotes.Decline"]</span></button>
            }
        </form>
    }
</div>
