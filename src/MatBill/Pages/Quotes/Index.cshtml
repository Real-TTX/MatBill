@page
@model MatBill.Pages.Quotes.IndexModel

<div class="mb-stats">
    @Ui.Kpi(L["Quotes.Kpi.Open"], Fmt.Money(Model.OpenSum), (Model.OpenCount == 1 ? L["Quotes.Count.One", Fmt.Integer(Model.OpenCount)] : L["Quotes.Count.Many", Fmt.Integer(Model.OpenCount)]), "clock", href: "/Quotes?status=open")
    @Ui.Kpi(L["Quotes.Kpi.Accepted", DateTime.Today.Year], Fmt.Money(Model.AcceptedSum), L["Quotes.Kpi.Accepted.Note"], "check-circle", href: "/Quotes?status=accepted")
    @Ui.Kpi(L["Quotes.Kpi.Rate"], Model.Rate + " %", L["Quotes.Kpi.Rate.Note"], "trending-up")
</div>

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    <partial name="_Table" model="Model.Table" />
    <partial name="_Pager" model="Model.Pager" />
    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Quotes/Edit">@Ui.Icon("plus")<span>@L["Quotes.New"]</span></a>
    </div>
</div>
