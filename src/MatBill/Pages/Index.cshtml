@page
@model MatBill.Pages.IndexModel

@if (Model.NeedsSetup)
{
    <div class="mat-alert mat-alert--info" role="note">
        @Ui.Icon("info")
        <div class="mat-alert__body">
            <strong>Noch ein Schritt bis zur ersten Rechnung:</strong>
            @if (Model.IsAdmin)
            {
                <span>Trage im <a href="/Branding">Branding</a> Firmennamen, Anschrift, Steuernummer und Bankverbindung ein. Sie stehen auf jeder Rechnung.</span>
            }
            else
            {
                <span>Ein Administrator muss im Branding Firmennamen, Steuernummer und Bankverbindung eintragen.</span>
            }
        </div>
    </div>
}

<div class="mb-stats">
    @Ui.Kpi("Offen", Fmt.Money(Model.Open), Ui.CountNoun(Model.OpenCount, "Rechnungen"), "clock", href: "/Invoices?status=offen")
    @Ui.Kpi("Überfällig", Fmt.Money(Model.Overdue), Model.OverdueCount == 0 ? "nichts überfällig" : Ui.CountNoun(Model.OverdueCount, "Rechnungen"), "alert", href: "/Invoices?status=ueberfaellig", bad: Model.OverdueCount > 0)
    @Ui.Kpi("Bezahlt im " + Model.Today.ToString("MMMM", Fmt.Culture), Fmt.Money(Model.PaidThisMonth), "Zahlungseingang", "check-circle", href: "/Invoices?status=bezahlt")
    @Ui.Kpi("Umsatz " + Model.Today.Year, Fmt.Money(Model.RevenueThisYear), "netto, ausgestellt", "trending-up", href: $"/Invoices?jahr={Model.Today.Year}")
    @Ui.Kpi("Ergebnis " + Model.Today.Year, Fmt.Money(Model.RevenueThisYear - Model.ExpensesThisYear), $"Ausgaben {Fmt.Money(Model.ExpensesThisYear)} netto", "bar-chart", href: "/Export", bad: Model.RevenueThisYear < Model.ExpensesThisYear)
</div>

@if (Model.SeriesProblems.Count > 0 || Model.SendProblems.Count > 0)
{
    <div class="mat-alert mat-alert--danger" role="alert">
        @Ui.Icon("x-circle")
        <div class="mat-alert__body">
            <strong>Das braucht einen Blick:</strong>
            <ul class="mat-alert__list">
                @foreach (var s in Model.SeriesProblems)
                {
                    <li><a href="/Recurring/Edit?id=@s.Id">Serie „@s.Name“</a>: @s.LastError</li>
                }
                @foreach (var i in Model.SendProblems)
                {
                    <li><a href="/Invoices/Edit?id=@i.Id">Rechnung @i.Number</a> wurde nicht versendet: @i.SendError</li>
                }
            </ul>
        </div>
    </div>
}

@if (Model.OpenBookings > 0 || Model.ExpensesToReview > 0 || Model.OpenQuotes > 0)
{
    <div class="mat-alert mat-alert--info" role="note">
        @Ui.Icon("info")
        <div class="mat-alert__body">
            <strong>Zu erledigen:</strong>
            <ul class="mat-alert__list">
                @if (Model.OpenBookings > 0) { <li><a href="/Banking?status=offen">@Model.OpenBookings Kontoumsätze ohne Zuordnung</a></li> }
                @if (Model.ExpensesToReview > 0) { <li><a href="/Expenses?status=pruefen">@Model.ExpensesToReview hochgeladene Belege prüfen</a></li> }
                @if (Model.OpenQuotes > 0) { <li><a href="/Quotes?status=offen">@Model.OpenQuotes offene Angebote warten auf Antwort</a></li> }
            </ul>
        </div>
    </div>
}

@if (Model.IsEmpty)
{
    <div class="mat-empty mat-empty--framed mat-empty--first">
        <span class="mat-empty__icon">@Ui.Icon("file-text")</span>
        <div class="mat-empty__title">Deine erste Rechnung</div>
        <p>Schreib sie direkt auf dem Dokument: Kunde eintippen, Positionen wählen, Summen und Steuern rechnen sich selbst.</p>
        <div class="mat-btn-row mat-btn-row--plain">
            <a class="mat-btn mat-btn--primary" href="/Invoices/Edit">@Ui.Icon("plus")<span>Neue Rechnung</span></a>
            @if (Model.IsAdmin)
            {
                <a class="mat-btn mat-btn--secondary" href="/Admin/System">@Ui.Icon("sparkles")<span>Beispieldaten ansehen</span></a>
            }
        </div>
    </div>
}

<div class="mat-grid mat-grid--2">
    <section class="mat-card" aria-labelledby="upcoming-title">
        <div class="mat-card__head">@Ui.Icon("repeat")<h2 class="mat-card__title" id="upcoming-title">Nächste Serienrechnungen</h2></div>
        <div class="mat-card__body">
            @if (Model.Upcoming.Count == 0)
            {
                <p class="mat-muted">Keine Serie aktiv. In einer Rechnung richtest du mit „Wiederholung einrichten“ eine ein.</p>
            }
            else
            {
                <ul class="mb-notes">
                    @foreach (var (s, gross) in Model.Upcoming)
                    {
                        <li class="mb-note">
                            @Ui.Icon("calendar", "mb-note__icon mb-note__icon--info")
                            <div class="mb-note__body">
                                <a class="mb-note__title" href="/Recurring/Edit?id=@s.Id">@s.Name</a>
                                <span class="mb-note__meta">@Fmt.Due(s.NextRunDate, Model.Today) · @Labels.Of(s.Interval) · @Fmt.Money(gross)@(s.AutoSend ? " · wird versendet" : "")</span>
                            </div>
                        </li>
                    }
                </ul>
            }
            <p class="mat-hint"><a href="/Recurring">Alle wiederkehrenden Rechnungen</a></p>
        </div>
    </section>

    <section class="mat-card" aria-labelledby="overdue-title">
        <div class="mat-card__head">@Ui.Icon("alert")<h2 class="mat-card__title" id="overdue-title">Überfällig</h2></div>
        <div class="mat-card__body">
            @if (Model.OverdueList.Count == 0)
            {
                <p class="mat-muted">Nichts überfällig.</p>
            }
            else
            {
                <ul class="mb-notes">
                    @foreach (var i in Model.OverdueList)
                    {
                        <li class="mb-note">
                            @Ui.Icon("clock", "mb-note__icon mb-note__icon--error")
                            <div class="mb-note__body">
                                <a class="mb-note__title" href="/Invoices/Edit?id=@i.Id">@i.Number · @i.RecipientName</a>
                                <span class="mb-note__meta">@Fmt.Money(i.GrossTotal) · fällig seit @Fmt.Date(i.DueDate) (@(Model.Today.DayNumber - i.DueDate.DayNumber) Tage)</span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
</div>

<section class="mat-card" aria-labelledby="recent-title">
    <div class="mat-card__head">@Ui.Icon("file-text")<h2 class="mat-card__title" id="recent-title">Zuletzt bearbeitet</h2>@if (Model.Drafts > 0) { <a class="mat-card__sub" href="/Invoices?status=entwurf">@Ui.CountNoun(Model.Drafts, "Entwürfe")</a> }</div>
    <div class="mat-card__body">
        @if (Model.Recent.Count == 0)
        {
            <p class="mat-muted">Noch keine Rechnung.</p>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Zuletzt bearbeitete Rechnungen</caption>
                    <thead><tr><th scope="col">Nummer</th><th scope="col">Kunde</th><th scope="col" class="mat-hide-sm">Datum</th><th scope="col" class="mat-num">Betrag</th><th scope="col">Status</th></tr></thead>
                    <tbody>
                        @foreach (var i in Model.Recent)
                        {
                            <tr>
                                <td data-label="Nummer"><a href="/Invoices/Edit?id=@i.Id">@(i.Number ?? "Entwurf")</a></td>
                                <td data-label="Kunde">@i.RecipientName</td>
                                <td data-label="Datum" class="mat-hide-sm">@Fmt.Date(i.InvoiceDate)</td>
                                <td data-label="Betrag" class="mat-num">@Ui.Money(i.GrossTotal)</td>
                                <td data-label="Status">@Labels.Pill(i, Model.Today)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
