<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>MatBill</RootNamespace>
    <AssemblyName>MatBill</AssemblyName>
    <UserSecretsId>matbill</UserSecretsId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <!-- Pinned to the same version as the design-time package, so the tests resolve one consistent EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Draws the QR code of the authenticator app set-up as SVG (pure managed, no external service) -->
    <PackageReference Include="QRCoder" Version="1.*" />
    <!-- Draws the invoices as PDF (community licence, set in Program.cs) -->
    <PackageReference Include="QuestPDF" Version="2025.*" />
    <!-- Sends invoices by mail (SMTP) -->
    <PackageReference Include="MailKit" Version="4.*" />
    <!-- MailKit brings an older one with known vulnerabilities: pinned to the patched release -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- SMB client: the files of the invoices and backups on a NAS -->
    <PackageReference Include="SMBLibrary" Version="1.5.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MatBill.Core\MatBill.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MatBill.Tests" />
  </ItemGroup>

</Project>
